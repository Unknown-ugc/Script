local mini = Instance.new("ImageButton",gui)
mini.Size = UDim2.fromOffset(50,50)
mini.Position = UDim2.new(.5,-25,0,10)
mini.BackgroundColor3 = BG
mini.BorderSizePixel = 0
mini.Image = "https://www.roblox.com/asset-thumbnail/image?assetId=85422381974829&width=420&height=420&format=png"
mini.Visible = false
mini.AutoButtonColor = false
Instance.new("UICorner",mini).CornerRadius = UDim.new(1,0)

local miniStroke = Instance.new("UIStroke",mini)
miniStroke.Color = THEME
miniStroke.Thickness = 2

local miniDragging = false
local miniStart
local miniPos

mini.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		miniDragging = false
		miniStart = input.Position
		miniPos = mini.Position

		local move

		move = UIS.InputChanged:Connect(function(m)
			if m.UserInputType == Enum.UserInputType.MouseMovement
			or m.UserInputType == Enum.UserInputType.Touch then

				local delta = m.Position-miniStart

				if math.abs(delta.X)>5 or math.abs(delta.Y)>5 then
					miniDragging = true
				end

				if miniDragging then
					mini.Position = UDim2.new(
						miniPos.X.Scale,
						miniPos.X.Offset+delta.X,
						miniPos.Y.Scale,
						miniPos.Y.Offset+delta.Y
					)
				end
			end
		end)

		local ended

		ended = UIS.InputEnded:Connect(function(e)
			if e.UserInputType == Enum.UserInputType.MouseButton1
			or e.UserInputType == Enum.UserInputType.Touch then

				move:Disconnect()
				ended:Disconnect()
			end
		end)
	end
end)

mini.Activated:Connect(function()
	if not miniDragging then
		main.Visible = true
		mini.Visible = false
	end
end)

minimize.Activated:Connect(function()
	main.Visible = false
	mini.Visible = true
end)

close.Activated:Connect(function()
	song:Stop()
	gui:Destroy()
end)

-- DRAG MAIN

local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and
		(input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then

		local delta = input.Position-dragStart

		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset+delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset+delta.Y
		)
	end
end)
