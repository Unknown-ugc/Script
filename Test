local function applyTheme(theme)
	Theme = theme

	main.BackgroundColor3 = theme.BG
	mainStroke.Color = theme.Main
	nav.BackgroundColor3 = theme.Card
	homeLine.BackgroundColor3 = theme.Card

	keyTab.BackgroundColor3 = theme.Main
	colorButton.BackgroundColor3 = theme.Card

	colorTitle.TextColor3 = theme.Main

	for _,child in ipairs(scriptList:GetChildren()) do
		if child:IsA("Frame") then
			child.BackgroundColor3 = theme.Card

			for _,obj in ipairs(child:GetChildren()) do
				if obj:IsA("TextButton") then
					obj.BackgroundColor3 = theme.Main
				end
			end
		end
	end

	settingsTitle.TextColor3 = Color3.new(1,1,1)
end

