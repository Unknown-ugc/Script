-- TRANSPARENCY

local transparencyText = Instance.new("TextLabel",main)
transparencyText.BackgroundTransparency = 1
transparencyText.Position = UDim2.fromOffset(10,163)
transparencyText.Size = UDim2.fromOffset(250,16)
transparencyText.Text = "Transparency: 0%"
transparencyText.TextColor3 = SUB
transparencyText.Font = Enum.Font.Gotham
transparencyText.TextSize = 8
transparencyText.TextXAlignment = Enum.TextXAlignment.Left

local bar = Instance.new("Frame",main)
bar.Size = UDim2.fromOffset(250,5)
bar.Position = UDim2.fromOffset(10,180)
bar.BackgroundColor3 = CARD
bar.BorderSizePixel = 0

Instance.new("UICorner",bar).CornerRadius = UDim.new(1,0)

local dot = Instance.new("TextButton",bar)
dot.Size = UDim2.fromOffset(14,14)
dot.Position = UDim2.new(0,-7,0.5,-7)
dot.BackgroundColor3 = BLUE
dot.BorderSizePixel = 0
dot.Text = ""

Instance.new("UICorner",dot).CornerRadius = UDim.new(1,0)

local dragging = false

local function setTransparency(inputX)
	local percent = math.clamp(
		(inputX - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
		0,
		1
	)

	dot.Position = UDim2.new(percent,-7,0.5,-7)

	local value = math.floor(percent * 100)
	transparencyText.Text = "Transparency: "..value.."%"

	main.BackgroundTransparency = percent
end

dot.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then
		setTransparency(input.Position.X)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

-- SONG

local SoundService = game:GetService("SoundService")

local song = Instance.new("Sound")
song.Name = "SettingsSong"
song.Volume = 0.5
song.Looped = true
song.Parent = SoundService

play.Activated:Connect(function()
	local id = songBox.Text:gsub("%D","")

	if id ~= "" then
		song.SoundId = "rbxassetid://"..id
		song:Play()
	end
end)

stop.Activated:Connect(function()
	song:Stop()
end)

close.Activated:Connect(function()
	song:Stop()
	gui:Destroy()
end)
