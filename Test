local mini = Instance.new("ImageButton",gui)
mini.Size = UDim2.fromOffset(50,50)
mini.Position = UDim2.new(0.5,-25,0,10)
mini.BackgroundColor3 = BG
mini.BorderSizePixel = 0
mini.Image = "https://www.roblox.com/asset-thumbnail/image?assetId=85422381974829&width=420&height=420&format=png"
mini.Visible = false
mini.AutoButtonColor = false

Instance.new("UICorner",mini).CornerRadius = UDim.new(1,0)

local miniStroke = Instance.new("UIStroke",mini)
miniStroke.Color = THEME
miniStroke.Thickness = 2

local miniDragging = false
local miniDragStart
local miniStartPos

mini.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		miniDragging = false
		miniDragStart = input.Position
		miniStartPos = mini.Position

		local moveConnection

		moveConnection = UIS.InputChanged:Connect(function(move)
			if move.UserInputType == Enum.UserInputType.MouseMovement
			or move.UserInputType == Enum.UserInputType.Touch then

				local delta = move.Position - miniDragStart

				if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
					miniDragging = true
				end

				if miniDragging then
					mini.Position = UDim2.new(
						miniStartPos.X.Scale,
						miniStartPos.X.Offset + delta.X,
						miniStartPos.Y.Scale,
						miniStartPos.Y.Offset + delta.Y
					)
				end
			end
		end)

		local endConnection

		endConnection = UIS.InputEnded:Connect(function(endInput)
			if endInput.UserInputType == Enum.UserInputType.MouseButton1
			or endInput.UserInputType == Enum.UserInputType.Touch then

				if moveConnection then
					moveConnection:Disconnect()
				end

				if endConnection then
					endConnection:Disconnect()
				end
			end
		end)
	end
end)

mini.Activated:Connect(function()
	if miniDragging then
		return
	end

	main.Visible = true
	mini.Visible = false
end)

minimize.Activated:Connect(function()
	main.Visible = false
	mini.Visible = true
end)

close.Activated:Connect(function()
