local function updateMostUsed()
	local data = {}

	for name,count in pairs(Uses) do
		table.insert(data,{name=name,count=count})
	end

	table.sort(data,function(a,b)
		return a.count > b.count
	end)

	for i = 1,3 do
		if data[i] then
			mostRows[i].Text =
				i.."   "..data[i].name.." ("..data[i].count..")"
			mostRows[i].TextColor3 = TEXT
		else
			mostRows[i].Text =
				i.."   No scripts used yet"
			mostRows[i].TextColor3 = SUB
		end
	end
end

