    clearServerList()

    if #servers == 0 then

        status.Text = "● NO SERVERS FOUND"
        status.TextColor3 = YELLOW

        return
    end

    for index,server in ipairs(servers) do
        createServerCard(server,index)
    end

    status.Text =
        "● " ..
        tostring(#servers) ..
        " SERVERS AVAILABLE"

    status.TextColor3 = GREEN
end

