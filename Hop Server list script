            if not wanted or wanted < 1 or wanted > 7 then
                serverData.frame.Visible = true
            else
                serverData.frame.Visible =
                    serverData.players == wanted
            end
        end

        updateCanvas()
    end

    filter:GetPropertyChangedSignal("Text"):Connect(function()
        local cleaned = filter.Text:gsub("%D", "")

        if #cleaned > 1 then
            cleaned = string.sub(cleaned, 1, 1)
