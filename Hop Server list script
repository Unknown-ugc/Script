local function corner(x,r)
	local c=Instance.new("UICorner",x)
	c.CornerRadius=UDim.new(0,r or 14)
end

local function outline(x)
	local s=Instance.new("UIStroke",x)
	s.Color=Color3.fromRGB(35,125,255)
	s.Thickness=1.5
end

local function drag(f)
	local moving,start,pos
	f.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then
			moving=true
			start=i.Position
			pos=f.Position
		end
	end)

	U.InputChanged:Connect(function(i)
		if moving and i.UserInputType==Enum.UserInputType.MouseMovement then
			local v=i.Position-start
			f.Position=UDim2.new(
				pos.X.Scale,pos.X.Offset+v.X,
				pos.Y.Scale,pos.Y.Offset+v.Y
			)
		end
	end)

	U.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then
			moving=false
		end
	end)
end

local function button(par,text,pos,size,color)
	local b=Instance.new("TextButton",par)
	b.Position=pos
	b.Size=size
	b.Text=text
	b.TextSize=14
	b.Font=Enum.Font.GothamBold
	b.TextColor3=Color3.new(1,1,1)
	b.BackgroundColor3=color
	b.AutoButtonColor=true
	corner(b,12)
	return b
end

local function label(par,text,pos,size,ts,color)
	local l=Instance.new("TextLabel",par)
	l.Position=pos
	l.Size=size
	l.Text=text
	l.TextSize=ts
	l.Font=Enum.Font.Gotham
	l.TextColor3=color
	l.BackgroundTransparency=1
	l.TextXAlignment=Enum.TextXAlignment.Left
	return l
end

