local function getPlayerStyle(playing, maxPlayers)

    if playing <= 0 then
        return GREEN, "🟢 EMPTY"
    end

    if playing <= math.max(1, math.floor(maxPlayers * 0.3)) then
        return GREEN, "🟢 LOW"
    end

    if playing < maxPlayers then
        return YELLOW, "🟡 ACTIVE"
    end

    if playing >= maxPlayers then
        return RED, "🔴 FULL"
    end

    return GREY, "●"
end


