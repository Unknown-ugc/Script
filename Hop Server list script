local function fetchServers()
    local req = getRequest()

    if not req then
        return nil, "HTTP request unavailable"
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. tostring(PlaceId)
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return req({
            Url = url,
            Method = "GET"
        })
    end)

    if not success then
        return nil, "Request failed"
    end

    if type(response) == "string" then
        return response
    end

    local code = response.StatusCode or response.status_code

    if code and tonumber(code) ~= 200 then
        return nil, "HTTP " .. tostring(code)
    end

    local body =
        response.Body
        or response.body
        or response.ResponseBody

    if not body then
        return nil, "Empty response"
    end

    return body
end

local function joinServer(serverId, button)
    if not serverId or serverId == "" then
        return
    end

    if button then
        button.Text = "JOINING..."
        button.Active = false
    end

    task.spawn(function()
        local success = pcall(function()
            TeleportService:TeleportToPlaceInstance(
                PlaceId,
                serverId,
                Player
            )
        end)

        if not success and button and button.Parent then
            button.Text = "JOIN"
            button.Active = true
        end
    end)
end

