	title.TextColor3=Color3.new(1,1,1)
	title.BackgroundTransparency=1

	local close=btn(f,"❌",UDim2.new(1,-45,0,8),
		UDim2.fromOffset(35,30),Color3.fromRGB(190,45,55))
	close.MouseButton1Click:Connect(function() f:Destroy() end)

	local box=Instance.new("TextBox",f)
	box.Position=UDim2.fromOffset(20,52)
	box.Size=UDim2.new(1,-40,0,42)
	box.PlaceholderText="👥 How many players?"
	box.Text=""
	box.TextSize=15
	box.Font=Enum.Font.Gotham
	box.BackgroundColor3=Color3.fromRGB(245,250,255)
	box.TextColor3=Color3.fromRGB(20,20,30)
	corner(box,10)

	local find=btn(f,"🔍 FIND SERVER",
		UDim2.fromOffset(20,102),
		UDim2.new(1,-40,0,38),
		Color3.fromRGB(25,120,235))

	local status=Instance.new("TextLabel",f)
	status.Position=UDim2.fromOffset(20,148)
	status.Size=UDim2.new(1,-40,0,30)
	status.Text="🟢 Ready"
	status.TextSize=14
	status.Font=Enum.Font.Gotham
	status.TextColor3=Color3.new(1,1,1)
	status.BackgroundTransparency=1

	local join

	find.MouseButton1Click:Connect(function()
		local wanted=tonumber(box.Text)
		local req=request or http_request or (syn and syn.request)

		if not wanted then
			status.Text="⚠️ Enter a number"
			return
		end

		if not req then
			status.Text="⚠️ HTTP unavailable"
			return
		end

		status.Text="🔎 Searching..."

		local url="https://games.roblox.com/v1/games/"
			..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"

		local ok,r=pcall(function()
			return req({Url=url,Method="GET"})
		end)

		if not ok or not r or r.StatusCode~=200 then
			status.Text="⚠️ Server API unavailable"
			return
		end

		local data=H:JSONDecode(r.Body)

		for _,s in ipairs(data.data or {}) do
			if s.id~=game.JobId and s.playing==wanted then
				status.Text="🟢 Found: "..s.playing.."/"..s.maxPlayers

				if join then join:Destroy() end

				join=btn(f,"🚀 JOIN SERVER",
					UDim2.fromOffset(20,190),
					UDim2.new(1,-40,0,38),
					Color3.fromRGB(25,120,235))

				join.MouseButton1Click:Connect(function()
					status.Text="🚀 Teleporting..."
					local o=Instance.new("TeleportOptions")
					o.ServerInstanceId=s.id
					T:TeleportAsync(game.PlaceId,{p},o)
				end)

				return
			end
		end

		status.Text="❌ No matching server"
	end)

	local credit=Instance.new("TextLabel",f)
	credit.Position=UDim2.fromOffset(12,238)
	credit.Size=UDim2.fromOffset(110,20)
	credit.Text="Credit: Chris"
	credit.TextSize=11
	credit.TextColor3=Color3.fromRGB(190,220,255)
	credit.BackgroundTransparency=1
end

