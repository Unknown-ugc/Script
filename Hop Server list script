	local function getServer(wanted)
		local req=request or http_request or (syn and syn.request)
		if not req then return nil,"HTTP unavailable" end

		local cursor=""
		local checked=0

		for page=1,5 do
			if not searching then return nil,"Stopped" end

			local url="https://games.roblox.com/v1/games/"
				..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"

			if cursor~="" then
				url=url.."&cursor="..H:UrlEncode(cursor)
			end

			local ok,r=pcall(function()
				return req({Url=url,Method="GET"})
			end)

			if not ok or not r or r.StatusCode~=200 then
				return nil,"API unavailable"
			end

			local ok2,data=pcall(function()
				return H:JSONDecode(r.Body)
			end)

			if not ok2 then return nil,"Invalid response" end

			for _,s in ipairs(data.data or {}) do
				checked+=1

				-- EXACT COUNT + MAX 7 + NOT FULL + NOT CURRENT
				if s.id~=game.JobId
				and s.maxPlayers==7
				and s.playing==wanted
				and s.playing<s.maxPlayers then
					return s,checked
				end
			end

			cursor=data.nextPageCursor or ""
			if cursor=="" then break end
		end

		return nil,checked
	end

	local function teleportServer(s)
		status.Text="● Teleporting "..s.playing.."/7..."
		status.TextColor3=Color3.fromRGB(255,220,80)

		local ok=pcall(function()
			T:TeleportToPlaceInstance(game.PlaceId,s.id,p)
		end)

		if not ok then
			return false
		end

		return true
	end

	local function search(wanted,loopMode)
		if searching then return end
		searching=true

		task.spawn(function()
			while searching do
				status.Text="● Searching for "..wanted.."/7..."
				status.TextColor3=Color3.fromRGB(80,200,255)

				local s,checked=getServer(wanted)

				if not searching then break end

				if s then
					status.Text="● Found "..s.playing.."/7 • Teleporting"
					status.TextColor3=Color3.fromRGB(80,255,180)

					local ok=teleportServer(s)

					if ok then
						-- Give Roblox time to begin teleport.
						-- If teleport fails, TeleportInitFailed below
						-- will allow another search.
						task.wait(5)

						if loopMode and searching then
							status.Text="● Still here • Searching again..."
						elseif searching then
							searching=false
						end
					else
						status.Text="● Server filled • Retrying..."
						task.wait(1)
					end
				else
					status.Text="● No "..wanted.."/7 • Retrying..."
					task.wait(loopMode and 2 or 1)
				end

				if not loopMode and s then
					break
				end
			end

			searching=false
		end)
	end

	find.MouseButton1Click:Connect(function()
