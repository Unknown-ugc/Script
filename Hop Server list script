local function loadServers()
	if loadingServers then
		return
	end

	loadingServers = true

	StatusLabel.Text = "● SCANNING SERVERS..."
	StatusLabel.TextColor3 = CYAN

	clearServerCards()

	local result = fetchServers()
	servers = result

	local totalPlayers = 0

	for index, server in ipairs(servers) do
		totalPlayers += server.playing
		createServerCard(server, index)
	end

	if #servers == 0 then
		StatusLabel.Text = "● NO SERVERS FOUND"
		StatusLabel.TextColor3 = RED
	else
		StatusLabel.Text =
			"● LIVE    "
			.. tostring(#servers)
			.. " SERVERS    👥 "
			.. tostring(totalPlayers)

		StatusLabel.TextColor3 = GREEN
	end

	task.wait()

	local layout = ServerList:FindFirstChildOfClass("UIListLayout")

	if layout then
		ServerList.CanvasSize = UDim2.new(
			0,
			0,
			0,
			layout.AbsoluteContentSize.Y + 8
		)
	end

	loadingServers = false
end

