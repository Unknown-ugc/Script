--// HELPERS
local function Corner(Object, Radius)
    local CornerObject = Instance.new("UICorner")
    CornerObject.CornerRadius = UDim.new(0, Radius or 10)
    CornerObject.Parent = Object

    return CornerObject
end

local function Stroke(Object, Color, Transparency)
    local StrokeObject = Instance.new("UIStroke")

    StrokeObject.Color = Color
    StrokeObject.Transparency = Transparency or 0
    StrokeObject.Thickness = 1
    StrokeObject.Parent = Object

    return StrokeObject
end

local function Label(
    Parent,
    Text,
    TextSize,
    Position,
    Font,
    TextColor
)
    local NewLabel = Instance.new("TextLabel")

    NewLabel.BackgroundTransparency = 1
    NewLabel.Text = Text
    NewLabel.TextColor3 =
        TextColor or Color3.fromRGB(255, 255, 255)

    NewLabel.TextSize = TextSize
    NewLabel.Font = Font or Enum.Font.Gotham
    NewLabel.Position = Position
    NewLabel.Size = UDim2.new(1, 0, 0, 30)
    NewLabel.Parent = Parent

    return NewLabel
end

local function Button(
    Parent,
    Text,
    Position,
    Size,
    Color
)
    local NewButton = Instance.new("TextButton")

    NewButton.Text = Text
    NewButton.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    NewButton.TextSize = 14
    NewButton.Font = Enum.Font.GothamBold

    NewButton.BackgroundColor3 = Color
    NewButton.BorderSizePixel = 0
    NewButton.Position = Position
    NewButton.Size = Size

    NewButton.AutoButtonColor = false
    NewButton.Parent = Parent

    Corner(NewButton, 10)

    Stroke(
        NewButton,
        Color3.fromRGB(255, 255, 255),
        0.88
    )

    NewButton.MouseEnter:Connect(function()
        NewButton.BackgroundColor3 = Color3.new(
            math.min(Color.R + 0.06, 1),
            math.min(Color.G + 0.06, 1),
            math.min(Color.B + 0.06, 1)
        )
    end)

    NewButton.MouseLeave:Connect(function()
        NewButton.BackgroundColor3 = Color
    end)

    return NewButton
end

