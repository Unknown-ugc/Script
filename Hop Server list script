    --// API REQUEST WITH RETRIES
    local function GetServerPage(URL)

        for Attempt = 1, MAX_RETRIES do

            local Success, Response = pcall(function()

                return RequestFunction({
                    Url = URL,
                    Method = "GET"
                })

            end)

            if Success and Response then

                local StatusCode =
                    tonumber(Response.StatusCode)

                --// SUCCESS
                if not StatusCode
                    or (
                        StatusCode >= 200
                        and StatusCode < 300
                    ) then

                    local Body =
                        Response.Body
                        or Response.body

                    if Body and Body ~= "" then

                        local DecodeSuccess, Data =
                            pcall(function()

                                return HttpService:
                                    JSONDecode(Body)

                            end)

                        if DecodeSuccess
                            and Data then

                            return true, Data

                        end

                        return false,
                            "Invalid JSON response"
                    end

                    return false,
                        "Empty API response"
                end

                --// RATE LIMIT
                if StatusCode == 429 then

                    Status.Text = string.format(
                        "● Rate limited, retrying %d/%d...",
                        Attempt,
                        MAX_RETRIES
                    )

                    Status.TextColor3 =
                        Color3.fromRGB(
                            255,
                            180,
                            80
                        )

                    task.wait(2 * Attempt)

                else

                    return false,
                        "HTTP error "
                        .. tostring(StatusCode)

                end

            else

                if Attempt < MAX_RETRIES then

                    Status.Text = string.format(
                        "● Request failed, retrying %d/%d...",
                        Attempt,
                        MAX_RETRIES
                    )

                    Status.TextColor3 =
                        Color3.fromRGB(
                            255,
                            180,
                            80
                        )

                    task.wait(Attempt)

                else

                    return false,
                        "Request failed"

                end
            end
        end

        return false,
            "Maximum retries reached"
    end

    --// SEARCH
    local function SearchServers()

        if Searching then
            return
        end

        Searching = true

        SearchID += 1

        local MySearchID = SearchID

        ClearServerList()

        RefreshButton.Text =
            "⏳ SEARCHING..."

        Status.Text =
            "● Starting server search..."

        Status.TextColor3 =
            Color3.fromRGB(
                100,
                180,
                255
            )

        if not RequestFunction then

            Status.Text =
                "● HTTP request function unavailable"

            Status.TextColor3 =
                Color3.fromRGB(
                    255,
                    90,
                    90
                )

            RefreshButton.Text =
                "🔄 REFRESH SERVERS"

            Searching = false

            return
        end

        local FoundServers = {}
        local Seen = {}
        local Cursor = nil

        local PagesScanned = 0
        local SearchError = nil

        --// PAGINATION
        for Page = 1, MAX_PAGES do

            if MySearchID ~= SearchID then
                return
            end

            PagesScanned = Page

            Status.Text = string.format(
                "● Searching page %d/%d...",
                Page,
                MAX_PAGES
            )

            local URL =
                "https://games.roblox.com/v1/games/"
                .. tostring(game.PlaceId)
                .. "/servers/Public?sortOrder=Asc&limit=100"

            if Cursor and Cursor ~= "" then

                URL =
                    URL
                    .. "&cursor="
                    .. HttpService:UrlEncode(Cursor)

            end

            local Success, Result =
                GetServerPage(URL)

            if not Success then

                SearchError = Result

                break
            end

            local Data = Result

            if type(Data.data) == "table" then

                for _, Server in ipairs(Data.data) do

                    if Server.id
                        and Server.id ~= game.JobId
                        and tonumber(Server.playing) == 1
                        and not Seen[Server.id] then

                        Seen[Server.id] = true

                        table.insert(
                            FoundServers,
                            Server
                        )

                    end
                end
            end

            Cursor =
                Data.nextPageCursor

            --// NO MORE PAGES
            if not Cursor
                or Cursor == "" then

                break
            end

            task.wait(0.1)
        end

        --// SEARCH WAS REPLACED
        if MySearchID ~= SearchID then
            return
        end

        table.sort(
            FoundServers,
            function(A, B)

                return tostring(A.id)
                    < tostring(B.id)

            end
        )

        --// CREATE SERVER CARDS
        for Index, Server in ipairs(
            FoundServers
        ) do

            local Card = Instance.new("Frame")

            Card.Name =
                "Server_" .. Index

            Card.Size =
                UDim2.new(1, -16, 0, 65)

