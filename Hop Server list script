local KEY_SYSTEM = false
local KEY = "key555"
local DISCORD = "https://discord.gg/FJK6QzNnf7"

local P = game:GetService("Players")
local T = game:GetService("TeleportService")
local H = game:GetService("HttpService")
local U = game:GetService("UserInputService")
local p = P.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "ServerFinder"
gui.ResetOnSpawn = false
gui.Parent = p:WaitForChild("PlayerGui")

local function corner(x)
	local c = Instance.new("UICorner",x)
	c.CornerRadius = UDim.new(0,12)
end

local function button(parent,text,pos,size)
	local b = Instance.new("TextButton",parent)
	b.Text=text
	b.Position=pos
	b.Size=size
	b.BackgroundColor3=Color3.fromRGB(45,45,60)
	b.TextColor3=Color3.new(1,1,1)
	b.TextSize=14
	corner(b)
	return b
end

-- KEY GUI
local function keyGui()
	local f=Instance.new("Frame",gui)
	f.Size=UDim2.fromOffset(340,230)
	f.Position=UDim2.new(.5,-170,.5,-115)
	f.BackgroundColor3=Color3.fromRGB(18,18,25)
	corner(f)

	local t=Instance.new("TextLabel",f)
	t.Size=UDim2.new(1,0,0,50)
	t.Text="KEY SYSTEM"
	t.TextSize=22
	t.TextColor3=Color3.new(1,1,1)
	t.BackgroundTransparency=1

	local box=Instance.new("TextBox",f)
	box.Position=UDim2.fromOffset(20,65)
	box.Size=UDim2.new(1,-40,0,42)
	box.PlaceholderText="Enter key..."
	box.Text=""
	box.TextSize=15
	box.BackgroundColor3=Color3.fromRGB(30,30,40)
	box.TextColor3=Color3.new(1,1,1)
	corner(box)

	local verify=button(f,"VERIFY KEY",UDim2.fromOffset(20,120),UDim2.new(1,-40,0,38))

	local dc=button(f,"SUPPORT DISCORD",UDim2.fromOffset(20,170),UDim2.new(1,-40,0,35))

	local status=Instance.new("TextLabel",f)
	status.Position=UDim2.fromOffset(20,205)
	status.Size=UDim2.new(1,-40,0,25)
	status.Text=""
	status.TextColor3=Color3.new(1,1,1)
	status.BackgroundTransparency=1

	dc.MouseButton1Click:Connect(function()
		if setclipboard then setclipboard(DISCORD) end
		status.Text="Discord link copied!"
	end)

	verify.MouseButton1Click:Connect(function()
		if box.Text==KEY then
			f:Destroy()
			task.wait(.1)
			serverGui()
		else
			status.Text="Invalid key"
		end
	end)
end

function serverGui()
	local f=Instance.new("Frame",gui)
	f.Size=UDim2.fromOffset(340,250)
	f.Position=UDim2.new(.5,-170,.5,-125)
	f.BackgroundColor3=Color3.fromRGB(18,18,25)
	corner(f)

	local t=Instance.new("TextLabel",f)
	t.Size=UDim2.new(1,-50,0,50)
	t.Text="SERVER FINDER"
	t.TextSize=21
	t.TextColor3=Color3.new(1,1,1)
	t.BackgroundTransparency=1

	local close=button(f,"X",UDim2.new(1,-45,0,10),UDim2.fromOffset(35,30))
	close.MouseButton1Click:Connect(function() f:Destroy() end)

	local box=Instance.new("TextBox",f)
	box.Position=UDim2.fromOffset(20,60)
	box.Size=UDim2.new(1,-40,0,42)
	box.PlaceholderText="Players wanted..."
	box.Text=""
	box.TextSize=15
	box.BackgroundColor3=Color3.fromRGB(30,30,40)
	box.TextColor3=Color3.new(1,1,1)
	corner(box)

	local find=button(f,"FIND SERVER",UDim2.fromOffset(20,112),UDim2.new(1,-40,0,38))

	local status=Instance.new("TextLabel",f)
	status.Position=UDim2.fromOffset(20,155)
	status.Size=UDim2.new(1,-40,0,30)
	status.Text="Ready"
	status.TextColor3=Color3.new(1,1,1)
	status.BackgroundTransparency=1

	local join
	local serverId

	find.MouseButton1Click:Connect(function()
		local wanted=tonumber(box.Text)
		if not wanted then status.Text="Enter a number"; return end

		local req=request or http_request or (syn and syn.request)
		if not req then status.Text="HTTP request unavailable"; return end

		status.Text="Searching..."

		local url="https://games.roblox.com/v1/games/"..game.PlaceId..
			"/servers/Public?sortOrder=Asc&limit=100"

		local ok,r=pcall(function()
			return req({Url=url,Method="GET"})
		end)

		if not ok or not r or r.StatusCode~=200 then
			status.Text="Server API unavailable"
			return
		end

		local data=H:JSONDecode(r.Body)

		for _,s in ipairs(data.data or {}) do
			if s.id~=game.JobId and s.playing==wanted then
				serverId=s.id
				status.Text="Found: "..s.playing.."/"..s.maxPlayers

				if join then join:Destroy() end

				join=button(
					f,
					"JOIN SERVER",
					UDim2.fromOffset(20,195),
					UDim2.new(1,-40,0,38)
				)

				join.MouseButton1Click:Connect(function()
					local opt=Instance.new("TeleportOptions")
					opt.ServerInstanceId=serverId
					T:TeleportAsync(game.PlaceId,{p},opt)
				end)

				return
			end
		end

		status.Text="No matching server found"
	end)

	-- draggable
	local dragging=false
	local startPos
	local framePos

	f.InputBegan:Connect(function(v)
		if v.UserInputType==Enum.UserInputType.MouseButton1 then
			dragging=true
			startPos=v.Position
			framePos=f.Position
		end
	end)

	U.InputChanged:Connect(function(v)
		if dragging and v.UserInputType==Enum.UserInputType.MouseMovement then
			local d=v.Position-startPos
			f.Position=UDim2.new(
				framePos.X.Scale,
				framePos.X.Offset+d.X,
				framePos.Y.Scale,
				framePos.Y.Offset+d.Y
			)
		end
	end)

	U.InputEnded:Connect(function(v)
		if v.UserInputType==Enum.UserInputType.MouseButton1 then
			dragging=false
		end
	end)
end

if KEY_SYSTEM then
	keyGui()
else
	serverGui()
end
