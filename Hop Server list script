local function getServerData()

    local req = getRequest()

    if not req then
        return nil, "HTTP request unavailable"
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. tostring(PlaceId)
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return req({
            Url = url,
            Method = "GET",
            Headers = {
                ["Content-Type"] = "application/json"
            }
        })
    end)

    if not success or not response then
        return nil, "Request failed"
    end

    local statusCode =
        response.StatusCode
        or response.Status
        or 200

    if tonumber(statusCode) and tonumber(statusCode) >= 400 then
        return nil, "HTTP " .. tostring(statusCode)
    end

    local body =
        response.Body
        or response.body
        or response.ResponseBody

    if type(body) ~= "string" then
        return nil, "Invalid response"
    end

    local decoded

    success, decoded = pcall(function()
        return HttpService:JSONDecode(body)
    end)

    if not success or type(decoded) ~= "table" then
        return nil, "Invalid server data"
    end

    return decoded.data or {}, nil
end


local function fetchServers()

    local data, err = getServerData()

    if not data then
        return nil, err
    end

    local result = {}

    for _, server in ipairs(data) do

        if server.id and server.id ~= game.JobId then

            local playing = tonumber(server.playing) or 0
            local maxPlayers = tonumber(server.maxPlayers) or 0

            table.insert(result, {
                id = server.id,
                playing = playing,
                maxPlayers = maxPlayers
            })

        end
    end

    table.sort(result, function(a, b)

        if a.playing == b.playing then
            return tostring(a.id) < tostring(b.id)
        end

        return a.playing < b.playing
    end)

    return result, nil
end


local function joinServer(serverId, button)

    if not serverId then
        return
    end

    if button then
        button.Text = "JOINING..."
        button.Active = false
        button.AutoButtonColor = false
    end

    local success = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            PlaceId,
            serverId,
            Player
        )
    end)

    if not success and button and button.Parent then

        button.Text = "RETRY"
        button.Active = true
        button.AutoButtonColor = true

    end
end


