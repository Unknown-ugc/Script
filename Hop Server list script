local function loadServers()
    if loadingServers then
        return
    end

    loadingServers = true

    if StatusLabel then
        StatusLabel.Text = "Loading servers..."
    end

    clearServerCards()

    task.spawn(function()
        local body, errorMessage = fetchServers()

        if not body then
            if StatusLabel then
                StatusLabel.Text = errorMessage or "Failed to load servers"
                StatusLabel.TextColor3 = RED
            end

            loadingServers = false
            return
        end

        local success, data = pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if not success or type(data) ~= "table" then
            StatusLabel.Text = "Invalid server response"
            StatusLabel.TextColor3 = RED
            loadingServers = false
            return
        end

        for _, server in ipairs(data.data or {}) do
            if server.id
                and server.id ~= game.JobId
                and server.playing ~= nil
                and server.maxPlayers ~= nil then

                table.insert(servers, server)
            end
        end

        table.sort(servers, function(a, b)
            return (tonumber(a.playing) or 0)
                < (tonumber(b.playing) or 0)
        end)

        for _, server in ipairs(servers) do
            createServerCard(server)
        end

        if #servers > 0 then
            StatusLabel.Text = tostring(#servers) .. " servers found"
            StatusLabel.TextColor3 = GREY
        else
            StatusLabel.Text = "No public servers found"
            StatusLabel.TextColor3 = GREY
        end

        loadingServers = false
    end)
end

