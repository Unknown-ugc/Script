        "🔎  SMALL SERVER LIST",
        19,
        UDim2.new(0, 0, 0, 12),
        Enum.Font.GothamBold
    )

    FinderTitle.Size = UDim2.new(1, 0, 0, 30)

    local FinderSubtitle = Label(
        Content,
        "Find servers with 1 - 2 players",
        11,
        UDim2.new(0, 0, 0, 42),
        Enum.Font.Gotham,
        Color3.fromRGB(145, 155, 180)
    )

    FinderSubtitle.Size = UDim2.new(1, 0, 0, 22)

    --// REFRESH

    local RefreshButton = Button(
        Content,
        "🔄  REFRESH SERVERS",
        UDim2.new(0, 20, 0, 70),
        UDim2.new(1, -40, 0, 42),
        Color3.fromRGB(55, 105, 235)
    )

    --// STATUS

    local Status = Label(
        Content,
        "●  Ready",
        11,
        UDim2.new(0, 20, 0, 116),
        Enum.Font.GothamMedium,
        Color3.fromRGB(145, 155, 180)
    )

    Status.TextXAlignment = Enum.TextXAlignment.Left

    --// SERVER LIST

    local ServerList = Instance.new("ScrollingFrame")

    ServerList.Name = "ServerList"
    ServerList.Position = UDim2.new(0, 20, 0, 145)
    ServerList.Size = UDim2.new(1, -40, 1, -157)

    ServerList.BackgroundColor3 = Color3.fromRGB(17, 21, 34)
    ServerList.BorderSizePixel = 0

    ServerList.ScrollBarThickness = 4
    ServerList.ScrollBarImageColor3 = Color3.fromRGB(70, 120, 255)

    ServerList.CanvasSize = UDim2.new(0, 0, 0, 0)

    ServerList.Parent = Content

    Corner(ServerList, 10)
    Stroke(ServerList, Color3.fromRGB(55, 75, 120), 0.45)

    --// LIST LAYOUT

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 8)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Layout.Parent = ServerList

    local Padding = Instance.new("UIPadding")
    Padding.PaddingTop = UDim.new(0, 8)
    Padding.PaddingBottom = UDim.new(0, 8)
    Padding.PaddingLeft = UDim.new(0, 8)
    Padding.PaddingRight = UDim.new(0, 8)
    Padding.Parent = ServerList

    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()

        ServerList.CanvasSize = UDim2.new(
            0,
            0,
            0,
            Layout.AbsoluteContentSize.Y + 16
        )

    end)

    local Searching = false

    --// REQUEST FUNCTION

    local requestFunction =
        request
        or http_request
        or (syn and syn.request)

    --// SEARCH SERVERS

    local function SearchServers()

        if Searching then
            return
        end

        Searching = true

        -- Clear previous server cards
        for _, child in ipairs(ServerList:GetChildren()) do

            if child:IsA("Frame") then
                child:Destroy()
            end

        end

        ServerList.CanvasPosition = Vector2.new(0, 0)

        Status.Text = "●  Searching 1 - 2 player servers..."
        Status.TextColor3 = Color3.fromRGB(100, 180, 255)

        RefreshButton.Text = "⏳  SEARCHING..."

        local FoundServers = {}
        local Cursor = nil

        if not requestFunction then

            Status.Text = "●  Request function not available"
            Status.TextColor3 = Color3.fromRGB(255, 90, 90)

            RefreshButton.Text = "🔄  REFRESH SERVERS"

            Searching = false

            return
        end

        for Page = 1, MAX_PAGES do

            local Url =
                "https://games.roblox.com/v1/games/"
                .. game.PlaceId
                .. "/servers/Public?sortOrder=Asc&limit=100"

            if Cursor then
                Url = Url .. "&cursor=" .. HttpService:UrlEncode(Cursor)
            end

            local Success, Response = pcall(function()

                return requestFunction({
                    Url = Url,
                    Method = "GET",
                    Headers = {
                        ["Content-Type"] = "application/json"
                    }
                })

            end)

            if not Success or not Response then
                break
            end

            local Body = Response.Body

            if not Body then
                break
            end

            local DecodeSuccess, Data = pcall(function()
                return HttpService:JSONDecode(Body)
            end)

            if not DecodeSuccess or not Data then
                break
            end

            if Data.data then

                for _, Server in ipairs(Data.data) do

                    if Server.id
                        and Server.id ~= game.JobId
                        and (Server.playing == 1 or Server.playing == 2) then

                        table.insert(FoundServers, Server)

                    end

                end

            end

            Cursor = Data.nextPageCursor

            if not Cursor then
                break
            end

        end

        --// SORT

        table.sort(FoundServers, function(a, b)
            return a.playing < b.playing
        end)

        --// REMOVE DUPLICATES

        local UniqueServers = {}
        local Seen = {}

        for _, Server in ipairs(FoundServers) do

            if not Seen[Server.id] then

                Seen[Server.id] = true
                table.insert(UniqueServers, Server)

            end

        end

        --// CREATE CARDS

        for Index, Server in ipairs(UniqueServers) do

            local Card = Instance.new("Frame")

            Card.Name = "Server_" .. Index
            Card.Size = UDim2.new(1, -16, 0, 65)

            Card.BackgroundColor3 = Color3.fromRGB(24, 29, 45)
            Card.BorderSizePixel = 0

            Card.Parent = ServerList

            Corner(Card, 10)
            Stroke(Card, Color3.fromRGB(55, 75, 120), 0.5)

            -- SERVER NUMBER

            local ServerName = Instance.new("TextLabel")

            ServerName.BackgroundTransparency = 1
            ServerName.Position = UDim2.new(0, 12, 0, 8)
            ServerName.Size = UDim2.new(1, -115, 0, 23)

            ServerName.Text = "Server #" .. Index
            ServerName.TextColor3 = Color3.fromRGB(255, 255, 255)

            ServerName.TextSize = 14
            ServerName.Font = Enum.Font.GothamBold
            ServerName.TextXAlignment = Enum.TextXAlignment.Left

            ServerName.Parent = Card

            -- PLAYER COUNT

            local PlayerCount = Instance.new("TextLabel")

            PlayerCount.BackgroundTransparency = 1
            PlayerCount.Position = UDim2.new(0, 12, 0, 34)
            PlayerCount.Size = UDim2.new(1, -115, 0, 20)

            PlayerCount.Text =
                "👤 "
                .. tostring(Server.playing)
                .. " / "
                .. tostring(Server.maxPlayers)
                .. " players"

            PlayerCount.TextColor3 =
                Color3.fromRGB(145, 155, 180)

            PlayerCount.TextSize = 11
            PlayerCount.Font = Enum.Font.Gotham
            PlayerCount.TextXAlignment = Enum.TextXAlignment.Left

            PlayerCount.Parent = Card

            -- JOIN BUTTON

            local JoinButton = Instance.new("TextButton")

            JoinButton.Size = UDim2.fromOffset(82, 38)
            JoinButton.Position = UDim2.new(1, -92, 0.5, -19)

            JoinButton.Text = "JOIN"
            JoinButton.TextColor3 = Color3.fromRGB(255, 255, 255)

            JoinButton.TextSize = 12
            JoinButton.Font = Enum.Font.GothamBold

            JoinButton.BackgroundColor3 =
                Color3.fromRGB(55, 175, 105)

            JoinButton.BorderSizePixel = 0
            JoinButton.AutoButtonColor = false

            JoinButton.Parent = Card

            Corner(JoinButton, 9)
            Stroke(JoinButton, Color3.fromRGB(255, 255, 255), 0.88)

            JoinButton.MouseEnter:Connect(function()

                JoinButton.BackgroundColor3 =
                    Color3.fromRGB(70, 195, 120)

            end)

            JoinButton.MouseLeave:Connect(function()

                JoinButton.BackgroundColor3 =
                    Color3.fromRGB(55, 175, 105)

            end)

            JoinButton.MouseButton1Click:Connect(function()

                if Searching then
                    return
                end

                JoinButton.Text = "JOINING..."

                Status.Text = "●  Joining server..."
                Status.TextColor3 =
                    Color3.fromRGB(100, 180, 255)

                local Success, ErrorMessage = pcall(function()

                    TeleportService:TeleportToPlaceInstance(
                        game.PlaceId,
                        Server.id,
                        Player
                    )

                end)

                if not Success then

                    JoinButton.Text = "JOIN"

                    Status.Text = "●  Teleport failed"
                    Status.TextColor3 =
                        Color3.fromRGB(255, 90, 90)

                    warn(ErrorMessage)

                end

            end)

        end

        --// RESULT

        if #UniqueServers == 0 then

            Status.Text =
                "●  No 1 - 2 player servers found"

            Status.TextColor3 =
                Color3.fromRGB(255, 180, 80)

        else

            Status.Text =
                "●  Found "
                .. tostring(#UniqueServers)
                .. " small servers"

            Status.TextColor3 =
                Color3.fromRGB(80, 220, 130)

        end

        RefreshButton.Text =
            "🔄  REFRESH SERVERS"

        Searching = false

    end

    --// REFRESH BUTTON

    RefreshButton.MouseButton1Click:Connect(function()
        SearchServers()
    end)

    --// AUTO SEARCH

    task.delay(0.5, function()

        if ScreenGui.Parent then
            SearchServers()
        end

    end)

end

