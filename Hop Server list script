    local function loadServers()
        clearServers()

        status.Text = "Scanning servers..."
        statusDot.BackgroundColor3 = Color3.fromRGB(255, 190, 50)

        local req = getRequest()

        if not req then
            status.Text = "Request function unavailable"
            statusDot.BackgroundColor3 = Color3.fromRGB(255, 70, 90)
            return
        end

        local success, result = pcall(function()
            local url =
                "https://games.roblox.com/v1/games/"
                .. tostring(placeId)
                .. "/servers/Public?sortOrder=Asc&limit=100"

            return req({
                Url = url,
                Method = "GET",
                Headers = {
                    ["Content-Type"] = "application/json"
                }
            })
        end)

        if not success or not result then
            status.Text = "Failed to load servers"
            statusDot.BackgroundColor3 = Color3.fromRGB(255, 70, 90)
            return
        end

        local body = result.Body or result.body

        if not body then
            status.Text = "No server data"
            statusDot.BackgroundColor3 = Color3.fromRGB(255, 70, 90)
            return
        end

        local decodedSuccess, data = pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if not decodedSuccess or not data then
            status.Text = "Invalid server data"
            statusDot.BackgroundColor3 = Color3.fromRGB(255, 70, 90)
            return
        end

        for _, server in ipairs(data.data or {}) do
            if server.id ~= game.JobId then
                addServer(server)
            end
        end

        table.sort(servers, function(a, b)
            return a.players < b.players
        end)

        for index, serverData in ipairs(servers) do
            serverData.frame.LayoutOrder = index
        end

        status.Text = tostring(#servers) .. " public servers found"
        statusDot.BackgroundColor3 = Color3.fromRGB(30, 220, 180)

        updateCanvas()
    end

    local function applyFilter()
        local wanted = tonumber(filter.Text)

