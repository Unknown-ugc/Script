	local function fetchServers()
		local req=getRequest()

		if not req then
			clearList()

			local err=label(
				list,
				"HTTP request unavailable",
				UDim2.fromOffset(10,10),
				UDim2.new(1,-20,0,30),
				13,
				Color3.fromRGB(255,100,110)
			)

			err.Parent=list
			return
		end

		clearList()

		local loading=label(
			list,
			"Searching servers...",
			UDim2.fromOffset(10,10),
			UDim2.new(1,-20,0,30),
			13,
			Color3.fromRGB(150,190,235)
		)

		loading.Parent=list

		local success,res=pcall(function()
			return req({
				Url="https://games.roblox.com/v1/games/"..tostring(game.PlaceId).."/servers/Public?sortOrder=Asc&limit=100",
				Method="GET",
				Headers={
					["Content-Type"]="application/json"
				}
			})
		end)

		if not success or not res then
			loading.Text="Failed to get servers"
			loading.TextColor3=Color3.fromRGB(255,100,110)
			return
		end

		if not res.Body then
			loading.Text="No server data received"
			loading.TextColor3=Color3.fromRGB(255,100,110)
			return
		end

		local decodedSuccess,data=pcall(function()
			return HttpService:JSONDecode(res.Body)
		end)

		if not decodedSuccess or not data or not data.data then
			loading.Text="Could not read server data"
			loading.TextColor3=Color3.fromRGB(255,100,110)
			return
		end

		loading:Destroy()

		local filter=tonumber(filterBox.Text)
		local found=0

		for _,server in ipairs(data.data) do
			if server.maxPlayers==7 then
				local playersNow=server.playing or 0

				if not filter or playersNow==filter then
					createServerCard(server)
					found+=1
				end
			end
		end

		if found==0 then
			local none=label(
				list,
				"No 7-player servers found",
				UDim2.fromOffset(10,10),
				UDim2.new(1,-20,0,30),
				13,
				Color3.fromRGB(150,190,235)
			)

			none.Parent=list
		end
	end

