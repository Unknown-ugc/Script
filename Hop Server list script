--// SERVER FINDER
function ShowServerFinder()

    Content:ClearAllChildren()

    local FinderTitle = Label(
        Content,
        "🔎  1 PLAYER SERVERS",
        18,
        UDim2.new(0, 20, 0, 15),
        Enum.Font.GothamBold
    )

    FinderTitle.TextXAlignment = Enum.TextXAlignment.Left
    FinderTitle.Size = UDim2.new(1, -40, 0, 28)

    local FinderSubtitle = Label(
        Content,
        "Find an almost empty public server",
        11,
        UDim2.new(0, 20, 0, 43),
        Enum.Font.Gotham,
        Color3.fromRGB(135, 145, 170)
    )

    FinderSubtitle.TextXAlignment = Enum.TextXAlignment.Left
    FinderSubtitle.Size = UDim2.new(1, -40, 0, 20)

    local SearchButton = Button(
        Content,
        "🔄  SEARCH SERVERS",
        UDim2.new(0, 20, 0, 70),
        UDim2.new(1, -40, 0, 43),
        Color3.fromRGB(55, 105, 235)
    )

    local Status = Label(
        Content,
        "● Ready to search",
        11,
        UDim2.new(0, 20, 0, 120),
        Enum.Font.GothamMedium,
        Color3.fromRGB(130, 200, 255)
    )

    Status.TextXAlignment = Enum.TextXAlignment.Left
    Status.Size = UDim2.new(1, -40, 0, 22)

    local ServerList = Instance.new("ScrollingFrame")
    ServerList.Size = UDim2.new(1, -40, 1, -155)
    ServerList.Position = UDim2.new(0, 20, 0, 145)
    ServerList.BackgroundTransparency = 1
    ServerList.BorderSizePixel = 0
    ServerList.ScrollBarThickness = 3
    ServerList.ScrollBarImageColor3 = Color3.fromRGB(70, 110, 220)
    ServerList.CanvasSize = UDim2.new(0, 0, 0, 0)
    ServerList.Parent = Content

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 9)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Parent = ServerList

    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ServerList.CanvasSize = UDim2.new(
            0,
            0,
            0,
            Layout.AbsoluteContentSize.Y + 10
        )
    end)

    local function SearchServers()

        for _, child in ipairs(ServerList:GetChildren()) do
            if child:IsA("Frame") then
                child:Destroy()
            end
        end

        Status.Text = "● Searching..."
        Status.TextColor3 = Color3.fromRGB(255, 200, 80)

        local RequestFunction =
            request
            or http_request
            or (syn and syn.request)

        if not RequestFunction then
            Status.Text = "● HTTP request unavailable"
            Status.TextColor3 = Color3.fromRGB(255, 90, 90)
            return
        end

        local Servers = {}
        local Cursor = ""

        for Page = 1, MAX_PAGES do

            local Url =
                "https://games.roblox.com/v1/games/"
                .. game.PlaceId
                .. "/servers/Public?sortOrder=Asc&limit=100"

            if Cursor ~= "" then
                Url = Url .. "&cursor=" .. HttpService:UrlEncode(Cursor)
            end

            local Success, Response = pcall(function()
                return RequestFunction({
                    Url = Url,
                    Method = "GET"
                })
            end)

            if not Success or not Response then
                break
            end

            local DecodeSuccess, Data = pcall(function()
                return HttpService:JSONDecode(Response.Body)
            end)

            if not DecodeSuccess or not Data then
                break
            end

            for _, Server in ipairs(Data.data or {}) do

                if Server.playing == 1
                    and Server.id ~= game.JobId then

                    table.insert(Servers, Server)
                end

            end

            Cursor = Data.nextPageCursor or ""

            if Cursor == "" then
                break
            end
        end

        table.sort(Servers, function(a, b)
            return a.playing < b.playing
        end)

        if #Servers == 0 then

            Status.Text = "● No 1-player servers found"
            Status.TextColor3 = Color3.fromRGB(255, 180, 80)
            return

        end

        Status.Text =
            "● Found " .. #Servers .. " server(s)"

        Status.TextColor3 =
            Color3.fromRGB(80, 220, 130)

        for Index, Server in ipairs(Servers) do

            local Card = Instance.new("Frame")
            Card.Size = UDim2.new(1, 0, 0, 62)
            Card.BackgroundColor3 = Color3.fromRGB(20, 25, 39)
            Card.BorderSizePixel = 0
            Card.LayoutOrder = Index
            Card.Parent = ServerList

            Corner(Card, 11)
            Stroke(Card, Color3.fromRGB(55, 70, 105), 0.45)

            local ServerName = Label(
                Card,
                "SERVER " .. Index,
                13,
                UDim2.new(0, 13, 0, 8),
                Enum.Font.GothamBold
            )

            ServerName.TextXAlignment = Enum.TextXAlignment.Left
            ServerName.Size = UDim2.new(0, 150, 0, 20)

            local PlayersLabel = Label(
                Card,
                "👤  1 PLAYER",
                10,
                UDim2.new(0, 13, 0, 31),
                Enum.Font.Gotham,
                Color3.fromRGB(120, 190, 255)
            )

            PlayersLabel.TextXAlignment = Enum.TextXAlignment.Left
            PlayersLabel.Size = UDim2.new(0, 120, 0, 18)

            local JoinButton = Button(
                Card,
                "JOIN",
                UDim2.new(1, -80, 0.5, -18),
                UDim2.fromOffset(67, 36),
                Color3.fromRGB(45, 175, 100)
            )

            JoinButton.TextSize = 12

            JoinButton.MouseButton1Click:Connect(function()

                Status.Text = "● Joining server..."
                Status.TextColor3 =
                    Color3.fromRGB(100, 180, 255)

                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    Server.id,
                    Player
                )

            end)
        end
    end

    SearchButton.MouseButton1Click:Connect(SearchServers)

    task.delay(0.5, SearchServers)
end

