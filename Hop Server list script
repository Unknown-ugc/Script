local function loadServers()

    if loadingServers then
        return
    end

    loadingServers = true

    clearServerCards()

    if StatusLabel then
        StatusLabel.Text = "● SCANNING SERVERS..."
        StatusLabel.TextColor3 = CYAN
    end

    local result, err = fetchServers()

    if not result then

        servers = {}

        if StatusLabel then
            StatusLabel.Text = "● ERROR • " .. tostring(err)
            StatusLabel.TextColor3 = RED
        end

        loadingServers = false
        return
    end

    servers = result

    local totalPlayers = 0

    for index, server in ipairs(servers) do

        totalPlayers +=
            tonumber(server.playing) or 0

        createServerCard(server, index)

    end

    if ServerList then
        ServerList.CanvasSize =
            UDim2.new(
                0,
                0,
                0,
                (#servers * 99) + 8
            )
    end

    if StatusLabel then

        StatusLabel.Text =
            "● LIVE    "
            .. tostring(#servers)
            .. " SERVERS    👥 "
            .. tostring(totalPlayers)
            .. " PLAYERS"

        StatusLabel.TextColor3 = GREEN

    end

    loadingServers = false
end


