        end

    end)

    task.wait(3)

    if not Loading.Parent then
        return
    end

    --// FADE OUT
    local fade1 = TweenService:Create(
        Loading,
        TweenInfo.new(0.3),
        {BackgroundTransparency = 1}
    )

    local fade2 = TweenService:Create(
        Title,
        TweenInfo.new(0.3),
        {TextTransparency = 1}
    )

    local fade3 = TweenService:Create(
        LoadingText,
        TweenInfo.new(0.3),
        {TextTransparency = 1}
    )

    local fade4 = TweenService:Create(
        Dots,
        TweenInfo.new(0.3),
        {TextTransparency = 1}
    )

    fade1:Play()
    fade2:Play()
    fade3:Play()
    fade4:Play()

    task.wait(0.35)

    if Loading.Parent then
        Loading:Destroy()
    end

    if callback then
        callback()
    end
end


--// CREATE KEY GUI
local KeyFrame
local KeyInput
local KeyVerify
local KeyMessage

if KEY_SYSTEM then

    KeyFrame, KeyInput, KeyVerify, KeyMessage = createKeyGui()

    local checking = false

    local function verifyKey()

        if checking then
            return
        end

        checking = true

        local entered = tostring(KeyInput.Text or "")

        if entered == KEY then

            KeyMessage.TextColor3 =
                Color3.fromRGB(40, 170, 90)

            KeyMessage.Text = "Key verified!"

            KeyInput.TextEditable = false
            KeyVerify.Active = false
            KeyVerify.AutoButtonColor = false
            KeyVerify.Text = "VERIFIED"

            task.wait(0.4)

            if KeyFrame and KeyFrame.Parent then
                KeyFrame.Visible = false
            end

            showLoading(function()

                if KeyFrame and KeyFrame.Parent then
                    KeyFrame:Destroy()
                end

                createMainGui()

            end)

        else

            KeyMessage.TextColor3 = RED
            KeyMessage.Text = "Invalid key"

            checking = false

            task.delay(1.5, function()

                if KeyMessage and KeyMessage.Parent then
                    KeyMessage.Text = ""
                end

            end)

        end
    end

    KeyVerify.MouseButton1Click:Connect(verifyKey)

    KeyInput.FocusLost:Connect(function(enterPressed)

        if enterPressed then
            verifyKey()
        end

    end)

else

    showLoading(function()
        createMainGui()
    end)

end
