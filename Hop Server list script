			card,
			playing>=maxPlayers and "FULL" or "JOIN",
			UDim2.new(1,-95,0,12),
			UDim2.fromOffset(80,38),
			playing>=maxPlayers
			and Color3.fromRGB(70,75,90)
			or Color3.fromRGB(20,125,240)
		)

		if playing>=maxPlayers then
			join.Active=false
			join.AutoButtonColor=false
		else
			join.MouseButton1Click:Connect(function()

				status.Text="● JOINING..."
				status.TextColor3=Color3.fromRGB(255,220,80)

				pcall(function()
					TeleportService:TeleportToPlaceInstance(
						game.PlaceId,
						server.id,
						player
					)
				end)

			end)
		end
	end

	local function fetchServers()

		clearList()

		status.Text="● LOADING SERVERS..."
		status.TextColor3=Color3.fromRGB(70,200,255)

		local req=getRequest()

		if not req then
			status.Text="● HTTP REQUEST UNAVAILABLE"
			status.TextColor3=Color3.fromRGB(255,90,110)
			return
		end

		local url=
			"https://games.roblox.com/v1/games/"
			..game.PlaceId
			.."/servers/Public?sortOrder=Asc&limit=100"

		local ok,res=pcall(function()
			return req({
				Url=url,
				Method="GET"
			})
		end)

		if not ok or not res or res.StatusCode~=200 then
			status.Text="● SERVER LIST UNAVAILABLE"
			status.TextColor3=Color3.fromRGB(255,180,70)
			return
		end

		local good,data=pcall(function()
			return HttpService:JSONDecode(res.Body)
		end)

		if not good or not data then
			status.Text="● SERVER LIST ERROR"
			status.TextColor3=Color3.fromRGB(255,90,110)
			return
		end

		local servers={}

		for _,server in ipairs(data.data or {}) do

			local playing=tonumber(server.playing) or 0
			local maxPlayers=tonumber(server.maxPlayers) or 0

			if server.id~=game.JobId
			and maxPlayers==7 then

				local wanted=tonumber(input.Text)

				if not wanted or playing==wanted then
					table.insert(servers,server)
				end
			end
		end

		table.sort(servers,function(a,b)
			return (tonumber(a.playing) or 0)
				<
				(tonumber(b.playing) or 0)
		end)

		for i,server in ipairs(servers) do
			addServer(server,i)
		end

		status.Text="● "..#servers.." SERVERS FOUND"
		status.TextColor3=Color3.fromRGB(70,255,175)
	end

	refresh.MouseButton1Click:Connect(fetchServers)

	input.FocusLost:Connect(function()
		fetchServers()
	end)

	fetchServers()
end

