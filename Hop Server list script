local function start()
	if KEY_SYSTEM then
		local KeyGui, KeyFrame, Input, Verify, Message =
			createKeyGui()

		local verified = false

		local function verify()
			if verified then
				return
			end

			if Input.Text == KEY then
				verified = true

				Message.TextColor3 = GREEN
				Message.Text = "✓ Key verified!"

				Verify.Text = "✓ VERIFIED"
				Verify.BackgroundColor3 = GREEN

				task.wait(0.5)

				if KeyFrame and KeyFrame.Parent then
					KeyFrame.Visible = false
				end

				showLoading(function()
					if KeyGui and KeyGui.Parent then
						KeyGui:Destroy()
					end

					createMainGui()
				end)
			else
				Message.TextColor3 = RED
				Message.Text = "✕ Invalid key"

				Input.Text = ""

				tween(Input, {
					Position = UDim2.fromOffset(24, 76)
				}, 0.08):Play()

				task.wait(0.08)

				tween(Input, {
					Position = UDim2.fromOffset(20, 76)
				}, 0.08):Play()
			end
		end

		Verify.MouseButton1Click:Connect(verify)

		Input.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				verify()
			end
		end)
	else
		showLoading(function()
			createMainGui()
		end)
	end
end

