	local function getRequest()
		return request or http_request or (syn and syn.request)
	end

	local function findServer(wanted)

		local req=getRequest()

		if not req then
			return nil,"HTTP unavailable"
		end

		local cursor=""
		checked=0

		for page=1,5 do

			if not searching then
				return nil,"Stopped"
			end

			local url=
				"https://games.roblox.com/v1/games/"
				..game.PlaceId
				.."/servers/Public?sortOrder=Asc&limit=100"

			if cursor~="" then
				url=url.."&cursor="..H:UrlEncode(cursor)
			end

			local ok,res=pcall(function()
				return req({
					Url=url,
					Method="GET"
				})
			end)

			if not ok or not res then
				return nil,"Request failed"
			end

			if res.StatusCode==429 then
				task.wait(3)
				continue
			end

			if res.StatusCode~=200 then
				return nil,"API "..tostring(res.StatusCode)
			end

			local good,data=pcall(function()
				return H:JSONDecode(res.Body)
			end)

			if not good or not data then
				return nil,"Bad response"
			end

			for _,s in ipairs(data.data or {}) do

				checked+=1
				count.Text="Servers checked: "..checked

				-- EXACTLY WANTED / 7
				if s.id~=game.JobId
				and tonumber(s.maxPlayers)==7
				and tonumber(s.playing)==wanted
				and tonumber(s.playing)<tonumber(s.maxPlayers) then

					return s,"Found"
				end
			end

			cursor=data.nextPageCursor or ""

			if cursor=="" then
				break
			end

			task.wait(.15)
		end

		return nil,"No match"
	end

	local function teleport(s,wanted)

		status.Text="●  TELEPORTING..."
		status.TextColor3=Color3.fromRGB(255,220,80)

		local ok,err=pcall(function()
			T:TeleportToPlaceInstance(
				game.PlaceId,
				s.id,
				p
			)
		end)

		if not ok then
			return false
		end

		-- Roblox may reject it if the server filled
		task.wait(3)

		if p.Parent then
			return false
		end

		return true
	end

	local function start(wanted,loopMode)

		if searching then return end

		searching=true
		checked=0

		targetStatus.Text="Searching for: "..wanted.."/7"

		task.spawn(function()

			while searching do

				count.Text="Servers checked: 0"
				status.Text="●  SEARCHING..."
				status.TextColor3=Color3.fromRGB(70,200,255)

				local s,reason=findServer(wanted)

				if not searching then
					break
				end

				if s then

					status.Text="●  FOUND "..s.playing.."/7"
					status.TextColor3=Color3.fromRGB(70,255,175)

					local success=teleport(s,wanted)

					if success then
						searching=false
						break
					end

					-- Server filled / teleport failed
					status.Text="●  SERVER FILLED • RETRYING"
					status.TextColor3=Color3.fromRGB(255,180,70)

					task.wait(1)

				else

					if reason=="Stopped" then
						break
					end

					status.Text="●  NO "..wanted.."/7 • RETRYING"
					status.TextColor3=Color3.fromRGB(255,180,70)

					task.wait(loopMode and 2 or 1)
				end

				if not loopMode and not s then
					-- FIND SERVER also retries once if no server
					task.wait(1)
				end
			end

			searching=false

			if not p.Parent then
				return
			end

			status.Text="●  READY"
			status.TextColor3=Color3.fromRGB(70,255,175)
		end)
	end

