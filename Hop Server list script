discordButton.Name = "DiscordButton"
discordButton.Size = UDim2.new(1,-24,0,32)
discordButton.Position = UDim2.new(0,12,1,-42)
discordButton.BackgroundColor3 = Color3.fromRGB(18,55,105)
discordButton.Text = "🌐 Join Discord"
discordButton.TextSize = 10
discordButton.Font = Enum.Font.GothamBold
discordButton.TextColor3 = WHITE
discordButton.Parent = main

corner(discordButton,10)
stroke(discordButton,BLUE,1)

discordButton.MouseButton1Click:Connect(function()

    copyText(DISCORD)

    local oldText = discordButton.Text

    discordButton.Text = "✓ Discord link copied!"

    task.delay(1.5,function()

        if discordButton.Parent then
            discordButton.Text = oldText
        end
    end)
end)

local collapsed = false

local expandedSize = UDim2.fromOffset(310,355)
local collapsedSize = UDim2.fromOffset(310,48)

collapse.MouseButton1Click:Connect(function()

    collapsed = not collapsed

    if collapsed then

        collapse.Text = "▼"

        for _,object in ipairs(main:GetChildren()) do

            if object ~= topControls
            and object ~= title then

                object.Visible = false
            end
        end

        topControls.Visible = true
        collapse.Visible = true
        close.Visible = true
        title.Visible = true

        title.Position = UDim2.fromOffset(80,7)
        title.Size = UDim2.new(1,-115,0,30)

        tween(main,0.3,{
            Size = collapsedSize
        })

    else

        tween(main,0.3,{
            Size = expandedSize
        })

        task.wait(0.3)

        for _,object in ipairs(main:GetChildren()) do
            object.Visible = true
        end

        collapse.Text = "▲"

        title.Position = UDim2.fromOffset(80,7)
        title.Size = UDim2.new(1,-115,0,30)

        topControls.Visible = true
        collapse.Visible = true
        close.Visible = true
        title.Visible = true
    end
end)

end

if KEY_SYSTEM then
    -- Key system is disabled
    -- This will not run because KEY_SYSTEM = false
    createMainGui()
else
    createLoading()

    task.wait(3)

    createMainGui()
end
