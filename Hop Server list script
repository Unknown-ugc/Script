local function corner(obj,r)
	local c=Instance.new("UICorner")
	c.CornerRadius=UDim.new(0,r)
	c.Parent=obj
end

local function stroke(obj,color,thickness)
	local s=Instance.new("UIStroke")
	s.Color=color
	s.Thickness=thickness or 1
	s.Transparency=0.15
	s.Parent=obj
end

local function tween(obj,time,props)
	local t=TweenService:Create(
		obj,
		TweenInfo.new(
			time,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		props
	)
	t:Play()
	return t
end

local function label(parent,text,pos,size,textSize,color)
	local l=Instance.new("TextLabel")
	l.Position=pos
	l.Size=size
	l.BackgroundTransparency=1
	l.Text=text
	l.TextSize=textSize
	l.Font=Enum.Font.Gotham
	l.TextColor3=color
	l.TextXAlignment=Enum.TextXAlignment.Left
	l.Parent=parent
	return l
end

local function button(parent,text,pos,size,color)
	local b=Instance.new("TextButton")
	b.Position=pos
	b.Size=size
	b.BackgroundColor3=color
	b.Text=text
	b.TextSize=14
	b.Font=Enum.Font.GothamBold
	b.TextColor3=Color3.new(1,1,1)
	b.AutoButtonColor=false
	b.BorderSizePixel=0
	b.Active=true
	b.Parent=parent

	corner(b,10)

	b.MouseEnter:Connect(function()
		tween(b,.12,{
			BackgroundColor3=Color3.fromRGB(
				math.min(color.R*255+15,255),
				math.min(color.G*255+15,255),
				math.min(color.B*255+15,255)
			)
		})
	end)

	b.MouseLeave:Connect(function()
		tween(b,.12,{
			BackgroundColor3=color
		})
	end)

	return b
end

local function drag(frame,handle)
	local dragging=false
	local dragStart
	local startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1
		or input.UserInputType==Enum.UserInputType.Touch then

			dragging=true
			dragStart=input.Position
			startPos=frame.Position
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType==Enum.UserInputType.MouseMovement
		or input.UserInputType==Enum.UserInputType.Touch then

			local delta=input.Position-dragStart

			frame.Position=UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset+delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset+delta.Y
			)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1
		or input.UserInputType==Enum.UserInputType.Touch then

			dragging=false
			savedPosition=frame.Position
		end
	end)
end

