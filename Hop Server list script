    local function loadServers()

        clear()

        status.Text="Scanning servers..."
        dot.BackgroundColor3=Color3.fromRGB(255,190,50)

        local req=getRequest()

        if not req then
            status.Text="Request unavailable"
            dot.BackgroundColor3=Color3.fromRGB(255,70,90)
            return
        end

        local success,result=pcall(function()

            local url=
                "https://games.roblox.com/v1/games/"
                ..tostring(placeId)
                .."/servers/Public?sortOrder=Asc&limit=100"

            return req({
                Url=url,
                Method="GET",
                Headers={
                    ["Content-Type"]="application/json"
                }
            })
        end)

        if not success or not result then
            status.Text="Failed to load servers"
            dot.BackgroundColor3=Color3.fromRGB(255,70,90)
            return
        end

        local body=result.Body or result.body

        if not body then
            status.Text="No server data"
            dot.BackgroundColor3=Color3.fromRGB(255,70,90)
            return
        end

        local ok,data=pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if not ok or not data then
            status.Text="Invalid server data"
            dot.BackgroundColor3=Color3.fromRGB(255,70,90)
            return
        end

        for _,server in ipairs(data.data or {}) do
            if server.id~=game.JobId then
                addServer(server)
            end
        end

        table.sort(servers,function(a,b)
            return a.players<b.players
        end)

        for i,v in ipairs(servers) do
            v.frame.LayoutOrder=i
        end

        status.Text=tostring(#servers).." public servers found"
        dot.BackgroundColor3=Color3.fromRGB(30,220,180)
        canvas()
    end

    local function applyFilter()

