local KEY_SYSTEM=false
local KEY="key555"
local DISCORD="https://discord.gg/FJK6QzNnf7"

local P=game:GetService("Players")
local T=game:GetService("TeleportService")
local H=game:GetService("HttpService")
local U=game:GetService("UserInputService")
local p=P.LocalPlayer

local gui=Instance.new("ScreenGui",p:WaitForChild("PlayerGui"))
gui.Name="ChrisServerFinder"
gui.ResetOnSpawn=false

local function round(x)
	local c=Instance.new("UICorner",x)
	c.CornerRadius=UDim.new(0,12)
end

local function drag(f)
	local d,s,pos
	f.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then
			d=true;s=i.Position;pos=f.Position
		end
	end)
	U.InputChanged:Connect(function(i)
		if d and i.UserInputType==Enum.UserInputType.MouseMovement then
			local v=i.Position-s
			f.Position=UDim2.new(pos.X.Scale,pos.X.Offset+v.X,pos.Y.Scale,pos.Y.Offset+v.Y)
		end
	end)
	U.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then d=false end
	end)
end

local function btn(par,text,pos,size,color)
	local b=Instance.new("TextButton",par)
	b.Text=text;b.Position=pos;b.Size=size
	b.BackgroundColor3=color;b.TextColor3=Color3.new(1,1,1)
	b.TextSize=13
	round(b)
	return b
end

local function mainGui()
	local f=Instance.new("Frame",gui)
	f.Size=UDim2.fromOffset(340,255)
	f.Position=UDim2.new(.5,-170,.5,-127)
	f.BackgroundColor3=Color3.fromRGB(15,70,150)
	f.Active=true;round(f);drag(f)

	local title=Instance.new("TextLabel",f)
	title.Size=UDim2.new(1,-55,0,45)
	title.Position=UDim2.fromOffset(15,5)
	title.Text="SERVER FINDER"
	title.TextSize=21
	title.Font=Enum.Font.GothamBold
	title.TextColor3=Color3.new(1,1,1)
	title.BackgroundTransparency=1

	local close=btn(f,"X",UDim2.new(1,-45,0,8),UDim2.fromOffset(35,30),
		Color3.fromRGB(190,45,55))
	close.MouseButton1Click:Connect(function() f:Destroy() end)

	local box=Instance.new("TextBox",f)
	box.Position=UDim2.fromOffset(20,55)
	box.Size=UDim2.new(1,-40,0,42)
	box.PlaceholderText="Players wanted..."
	box.Text=""
	box.TextSize=15
	box.BackgroundColor3=Color3.fromRGB(245,250,255)
	box.TextColor3=Color3.fromRGB(20,20,30)
	round(box)

	local find=btn(f,"🔎 FIND SERVER",
		UDim2.fromOffset(20,105),
		UDim2.fromOffset(145,40),
		Color3.fromRGB(25,110,220))

	local loop=btn(f,"🔁 LOOP FIND",
		UDim2.fromOffset(175,105),
		UDim2.fromOffset(145,40),
		Color3.fromRGB(30,130,210))

	local status=Instance.new("TextLabel",f)
	status.Position=UDim2.fromOffset(20,150)
	status.Size=UDim2.new(1,-40,0,30)
	status.Text="Ready"
	status.TextSize=14
	status.TextColor3=Color3.new(1,1,1)
	status.BackgroundTransparency=1

	local function search(wanted)
		local req=request or http_request or (syn and syn.request)
		if not req then return nil,"HTTP unavailable" end

		local url="https://games.roblox.com/v1/games/"..
			game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"

		local ok,r=pcall(function()
			return req({Url=url,Method="GET"})
		end)

		if not ok or not r or r.StatusCode~=200 then
			return nil,"API unavailable"
		end

		local ok2,data=pcall(function()
			return H:JSONDecode(r.Body)
		end)

		if not ok2 then return nil,"Invalid API response" end

		for _,s in ipairs(data.data or {}) do
			if s.id~=game.JobId and s.playing==wanted then
				return s
			end
		end

		return nil,"No server"
	end

	local searching=false

	local function teleport(s)
		searching=false
		status.Text="Teleporting..."

		local ok,err=pcall(function()
			T:TeleportToPlaceInstance(game.PlaceId,s.id,p)
		end)

		if not ok then
			status.Text="Teleport failed - retrying..."
			return false
		end

		task.delay(8,function()
			if p.Parent then
				status.Text="Teleport taking too long"
			end
		end)

		return true
	end

	find.MouseButton1Click:Connect(function()
		if searching then return end

		local wanted=tonumber(box.Text)
		if not wanted or wanted<0 then
			status.Text="Enter a player number"
			return
		end

		searching=true
		status.Text="Searching..."

		local s,err=search(wanted)

		if s then
			status.Text="Found: "..s.playing.."/"..s.maxPlayers
			teleport(s)
		else
			searching=false
			status.Text=err=="No server"
				and "No matching server found"
				or err
		end
	end)

	loop.MouseButton1Click:Connect(function()
		if searching then
			searching=false
			status.Text="Loop stopped"
			return
		end

		local wanted=tonumber(box.Text)
		if not wanted or wanted<0 then
			status.Text="Enter a player number"
			return
		end

		searching=true

		task.spawn(function()
			while searching do
				status.Text="🔁 Searching..."

				local s,err=search(wanted)

				if s then
					status.Text="Found: "..s.playing.."/"..s.maxPlayers
					teleport(s)
					break
				end

				status.Text="No match - retrying..."
				task.wait(2)
			end
		end)
	end)

	local credit=Instance.new("TextLabel",f)
	credit.Position=UDim2.fromOffset(12,225)
	credit.Size=UDim2.fromOffset(100,20)
	credit.Text="Credit: Chris"
	credit.TextSize=11
	credit.TextColor3=Color3.fromRGB(200,220,255)
	credit.BackgroundTransparency=1
end

