--// LOAD SERVERS
local function loadServers()

    if loadingServers then
        return
    end

    loadingServers = true

    if StatusLabel then
        StatusLabel.Text = "Loading servers..."
        StatusLabel.TextColor3 = GREY
    end

    clearServers()

    task.spawn(function()

        local body, errorMessage = fetchServers()

        if not body then

            if StatusLabel then
                StatusLabel.Text =
                    errorMessage or "Failed to load servers"
                StatusLabel.TextColor3 = RED
            end

            loadingServers = false
            return
        end

        local success, data = pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if not success or type(data) ~= "table" then

            if StatusLabel then
                StatusLabel.Text = "Invalid server response"
                StatusLabel.TextColor3 = RED
            end

            loadingServers = false
            return
        end

        local serverData = data.data or {}

        for _, server in ipairs(serverData) do

            if server.id
            and server.id ~= game.JobId
            and server.playing ~= nil
            and server.maxPlayers ~= nil then

                table.insert(servers, server)

            end

        end

        --// LOWEST PLAYERS FIRST
        table.sort(servers, function(a, b)

            local aPlayers = tonumber(a.playing) or 0
            local bPlayers = tonumber(b.playing) or 0

            if aPlayers == bPlayers then
                return tostring(a.id) < tostring(b.id)
            end

            return aPlayers < bPlayers

        end)

        for _, server in ipairs(servers) do
            createServerCard(server)
        end

        if #servers == 0 then

            StatusLabel.Text = "No public servers found"
            StatusLabel.TextColor3 = GREY

        else

            StatusLabel.Text =
                tostring(#servers)
                .. " servers found"

            StatusLabel.TextColor3 = GREY

        end

        loadingServers = false
    end)
end


