local function getServerData()
	local httpRequest = getRequest()

	if not httpRequest then
		return nil
	end

	local url =
		"https://games.roblox.com/v1/games/"
		.. tostring(PlaceId)
		.. "/servers/Public?sortOrder=Asc&limit=100"

	local success, response = pcall(function()
		return httpRequest({
			Url = url,
			Method = "GET"
		})
	end)

	if not success or not response or not response.Body then
		return nil
	end

	local data

	local decoded = pcall(function()
		data = HttpService:JSONDecode(response.Body)
	end)

	if not decoded or not data then
		return nil
	end

	return data.data or {}
end

local function fetchServers()
	local data = getServerData()

	if not data then
		return {}
	end

	local result = {}

	for _, server in ipairs(data) do
		if server.id and server.id ~= game.JobId then
			table.insert(result, {
				id = server.id,
				playing = tonumber(server.playing) or 0,
				maxPlayers = tonumber(server.maxPlayers) or 7
			})
		end
	end

	table.sort(result, function(a, b)
		if a.playing == b.playing then
			return tostring(a.id) < tostring(b.id)
		end

		return a.playing < b.playing
	end)

	return result
end

local function getServerStyle(playing, maxPlayers)
	if playing <= 0 then
		return GREEN, "🟢 EMPTY"
	elseif playing >= maxPlayers then
		return RED, "🔴 FULL"
	elseif playing <= math.max(2, math.floor(maxPlayers / 2)) then
		return YELLOW, "🟡 LOW"
	else
		return CYAN, "🔵 ACTIVE"
	end
end

