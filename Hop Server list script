	local searching=false

	local function getRequest()
		return request or http_request or (syn and syn.request)
	end

	-- FAST SERVER SEARCH
	local function findServer(wanted)

		local req=getRequest()

		if not req then
			return nil
		end

		local url=
			"https://games.roblox.com/v1/games/"
			..game.PlaceId
			.."/servers/Public?sortOrder=Asc&limit=100"

		local ok,res=pcall(function()

			return req({
				Url=url,
				Method="GET"
			})

		end)

		if not ok or not res then
			return nil
		end

		if res.StatusCode==429 then
			return nil
		end

		if res.StatusCode~=200 then
			return nil
		end

		local good,data=pcall(function()
			return H:JSONDecode(res.Body)
		end)

		if not good or not data then
			return nil
		end

		for _,s in ipairs(data.data or {}) do

			if not searching then
				return nil
			end

			local playing=tonumber(s.playing)
			local maxPlayers=tonumber(s.maxPlayers)

			if s.id~=game.JobId
			and maxPlayers==7
			and playing==wanted
			and playing<maxPlayers then

				return s
			end
		end

		return nil
	end

	-- IMMEDIATE TELEPORT
	local function teleport(s)

		if not s or not searching then
			return
		end

		pcall(function()

			T:TeleportToPlaceInstance(
				game.PlaceId,
				s.id,
				p
			)

		end)
	end

	-- CONTINUOUS FAST SEARCH
	local function start(wanted)

		if searching then
			return
		end

		searching=true

		targetStatus.Text="Searching for: "..wanted.."/7"
		status.Text="● SEARCHING..."
		status.TextColor3=Color3.fromRGB(70,200,255)

		task.spawn(function()

			while searching do

				local server=findServer(wanted)

				if not searching then
					break
				end

				if server then

					status.Text="● FOUND "..wanted.."/7"
					status.TextColor3=Color3.fromRGB(70,255,175)

					-- NO EXTRA WAIT
					teleport(server)

					-- Give Roblox a moment to process.
					-- If teleport doesn't happen, search again.
					task.wait(.35)

				else

					-- Very short retry delay
					task.wait(.15)

				end
			end
		end)
	end

	find.MouseButton1Click:Connect(function()

		local wanted=tonumber(box.Text)

		if not wanted then
			return
		end

		wanted=math.floor(wanted)

		if wanted<1 or wanted>6 then
			return
		end

		start(wanted)
	end)

	-- If Roblox rejects the teleport,
	-- the main loop automatically continues.
	T.TeleportInitFailed:Connect(function()

		if searching then

			task.defer(function()

				if searching then
					status.Text="● SEARCHING..."
					status.TextColor3=Color3.fromRGB(70,200,255)
				end

			end)

		end

	end)
