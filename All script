local function clearList()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
end

local function updateCanvas()
	task.wait()
	list.CanvasSize = UDim2.fromOffset(
		0,
		layout.AbsoluteContentSize.Y + 8
	)
end

-- KEY TAB

local function showKey()
	clearList()

	keyTab.BackgroundColor3 = Color3.fromRGB(35, 110, 190)
	keylessTab.BackgroundColor3 = Color3.fromRGB(29, 39, 55)

	for _, name in ipairs(keyNames) do
		addName(name)
	end

	updateCanvas()
end

-- KEYLESS TAB

local function showKeyless()
	clearList()

	keyTab.BackgroundColor3 = Color3.fromRGB(29, 39, 55)
	keylessTab.BackgroundColor3 = Color3.fromRGB(35, 110, 190)

	for _, name in ipairs(keylessNames) do
		addName(name)
	end

	updateCanvas()
end

