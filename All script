-- START

task.spawn(function()
	local duration = 3
	local startTime = os.clock()

	while true do
		local progress = math.clamp((os.clock() - startTime) / duration, 0, 1)
		local value = math.floor(progress * 100)

		bar.Size = UDim2.new(progress, 0, 1, 0)
		loadingText.Text = "Loading... " .. value .. "%"
		percent.Text = value .. "%"

		if value >= 100 then
			break
		end

		task.wait(0.03)
	end

	bar.Size = UDim2.new(1, 0, 1, 0)
	loadingText.Text = "Loading... 100%"
	percent.Text = "100%"

	task.wait(0.5)

	loading:Destroy()
	main.Visible = true

	showHome()
end)
