local function makePanel(data)

	local panel = Instance.new("Frame")
	panel.Name = data.Name
	panel.Size = UDim2.new(1, -8, 0, 205)
	panel.BackgroundColor3 = Color3.fromRGB(15, 24, 40)
	panel.BorderSizePixel = 0
	panel.LayoutOrder = data.Order
	panel.Parent = scroll

	makeCorner(panel, 11)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(45, 100, 210)
	stroke.Thickness = 1
	stroke.Transparency = 0.2
	stroke.Parent = panel

	local panelTitle = Instance.new("TextLabel")
	panelTitle.Size = UDim2.new(1, -16, 0, 27)
	panelTitle.Position = UDim2.fromOffset(8, 6)
	panelTitle.BackgroundTransparency = 1
	panelTitle.Font = Enum.Font.GothamBold
	panelTitle.Text = data.Title
	panelTitle.TextSize = 12
	panelTitle.TextColor3 = Color3.fromRGB(235, 242, 255)
	panelTitle.TextXAlignment = Enum.TextXAlignment.Left
	panelTitle.Parent = panel

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -16, 0, 82)
	box.Position = UDim2.fromOffset(8, 36)
	box.BackgroundColor3 = Color3.fromRGB(23, 34, 53)
	box.BorderSizePixel = 0
	box.ClearTextOnFocus = false
	box.MultiLine = true
	box.TextWrapped = true
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.TextYAlignment = Enum.TextYAlignment.Top
	box.Font = Enum.Font.Gotham
	box.TextSize = 10
	box.TextColor3 = Color3.fromRGB(230, 235, 245)
	box.PlaceholderColor3 = Color3.fromRGB(145, 158, 180)
	box.PlaceholderText = data.Placeholder
	box.Text = ""
	box.Parent = panel

	makeCorner(box, 8)

	local send = Instance.new("TextButton")
	send.Size = UDim2.new(1, -16, 0, 28)
	send.Position = UDim2.fromOffset(8, 124)
	send.BackgroundColor3 = Color3.fromRGB(40, 105, 220)
	send.BorderSizePixel = 0
	send.Font = Enum.Font.GothamBold
	send.TextSize = 10
	send.TextColor3 = Color3.new(1,1,1)
	send.Text = data.Button
	send.Parent = panel

	makeCorner(send, 7)

	local explanation = Instance.new("TextLabel")
	explanation.Size = UDim2.new(1, -16, 0, 40)
	explanation.Position = UDim2.fromOffset(8, 158)
	explanation.BackgroundTransparency = 1
	explanation.Font = Enum.Font.Gotham
	explanation.TextSize = 9
	explanation.TextColor3 = Color3.fromRGB(155, 170, 195)
	explanation.TextWrapped = true
	explanation.TextXAlignment = Enum.TextXAlignment.Left
	explanation.TextYAlignment = Enum.TextYAlignment.Top
	explanation.Text = data.Explanation
	explanation.Parent = panel

	send.MouseButton1Click:Connect(function()

		local message = box.Text

		if message == "" or #message < 3 then
			explanation.Text = "Please enter more information."
			explanation.TextColor3 = Color3.fromRGB(255, 100, 100)
			return
		end

		local now = os.time()
		local last = cooldowns[data.Type]

		if now - last < COOLDOWN then
			local remaining = COOLDOWN - (now - last)
			local hours = math.floor(remaining / 3600)
			local minutes = math.floor((remaining % 3600) / 60)

			explanation.Text =
				"Cooldown: " .. hours .. "h " .. minutes .. "m remaining."

			explanation.TextColor3 =
				Color3.fromRGB(255, 180, 80)

			return
		end

		local requestFunction =
			request
			or http_request
			or (syn and syn.request)

		if not requestFunction then
			explanation.Text = "HTTP request is unavailable."
			explanation.TextColor3 =
				Color3.fromRGB(255, 100, 100)
			return
		end

		if WEBHOOK_URL == ""
			or WEBHOOK_URL == "PASTE_YOUR_WEBHOOK_HERE" then

			explanation.Text = "Webhook URL is not configured."
			explanation.TextColor3 =
				Color3.fromRGB(255, 100, 100)
			return
		end

		send.Text = "SENDING..."
		send.Active = false

		local body = HttpService:JSONEncode({
			username = "Report Center",

			embeds = {{
				title = data.Title,
				description = message,
				color = 5793266,

				fields = {
					{
						name = "Username",
						value = player.Name,
						inline = true
					},

					{
						name = "UserId",
						value = tostring(player.UserId),
						inline = true
					},

					{
						name = "Type",
						value = data.Type,
						inline = true
					}
				},

				footer = {
					text = "12 Hour Cooldown"
				}
			}}
		})

		local success = pcall(function()
			requestFunction({
				Url = WEBHOOK_URL,
				Method = "POST",

				Headers = {
					["Content-Type"] = "application/json"
				},

				Body = body
			})
		end)

		if success then

			cooldowns[data.Type] = os.time()

			box.Text = ""
			send.Text = "SENT ✓"

			explanation.Text =
				"Sent successfully! You can submit again in 12 hours."

			explanation.TextColor3 =
				Color3.fromRGB(100, 220, 140)

			task.delay(3, function()
				if send.Parent then
					send.Text = data.Button
					send.Active = true
					explanation.Text = data.Explanation
					explanation.TextColor3 =
						Color3.fromRGB(155, 170, 195)
				end
			end)

		else

			send.Text = data.Button
			send.Active = true

			explanation.Text =
				"Failed to send. Please try again."

			explanation.TextColor3 =
				Color3.fromRGB(255, 100, 100)
		end
	end)
end

