local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local WEBHOOK_URL = "https://discord.com/api/webhooks/1547588055450521650/sst9fMdf8Q3aGmiXBTNv5yt4z9OLRse1377npW3rlAsBanvFPb6M1VuWpLJQbZ3R6bR8"

local remote = ReplicatedStorage:FindFirstChild("ReportWebhook")

if not remote then
	remote = Instance.new("RemoteEvent")
	remote.Name = "ReportWebhook"
	remote.Parent = ReplicatedStorage
end

local function sendDiscord(title, description)
	if WEBHOOK_URL == "PASTE_YOUR_DISCORD_WEBHOOK_HERE" then
		warn("Put your Discord webhook URL in WEBHOOK_URL")
		return
	end

	local data = {
		username = "Roblox Report System",
		embeds = {{
			title = title,
			description = description,
			color = 5793266,
			timestamp = DateTime.now():ToIsoDate()
		}}
	}

	local success, result = pcall(function()
		return HttpService:RequestAsync({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = HttpService:JSONEncode(data)
		})
	end)

	if not success then
		warn("Discord webhook error:", result)
	end
end

remote.OnServerEvent:Connect(function(player, reportType, data)
	if typeof(data) ~= "table" then
		return
	end

	if reportType == "report" then
		local issue = tostring(data.issue or "")
		local scriptName = tostring(data.scriptName or "None")

		issue = issue:sub(1, 3500)
		scriptName = scriptName:sub(1, 500)

		sendDiscord(
			"📤 New Issue Report",
			"**Player:** " .. player.Name ..
			"\n**UserId:** " .. player.UserId ..
			"\n**Script Name:** " .. scriptName ..
			"\n\n**Issue:**\n" .. issue
		)

	elseif reportType == "addscript" then
		local suggestion = tostring(data.suggestion or "None")
		local scriptText = tostring(data.script or "None")

		suggestion = suggestion:sub(1, 500)
		scriptText = scriptText:sub(1, 3500)

		sendDiscord(
			"📜 New Add Script Request",
			"**Player:** " .. player.Name ..
			"\n**UserId:** " .. player.UserId ..
			"\n\n**Script Name Suggestion:**\n" .. suggestion ..
			"\n\n**Script They Want Added:**\n" .. scriptText
		)
	end
end)

