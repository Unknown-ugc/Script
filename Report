-- DRAG

local dragging = false
local dragStart
local startPosition

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

-- HELPERS

local function clean(text)
	return text:gsub("^%s+", ""):gsub("%s+$", "")
end

local function formatTime(seconds)
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	return h .. "h " .. m .. "m"
end

local function sendWebhook(titleText, description)
	if WEBHOOK_URL == "PASTE_YOUR_WEBHOOK_HERE" then
		status.Text = "Webhook not configured."
		return false
	end

	local data = {
		username = "Report & Script Center",
		embeds = {{
			title = titleText,
			description = description,
			color = 5793266,
			timestamp = DateTime.now():ToIsoDate()
		}}
	}

	local success = pcall(function()
		local response = HttpService:RequestAsync({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = HttpService:JSONEncode(data)
		})

		if not response.Success then
			error("Webhook failed")
		end
	end)

	return success
end

-- REPORT

reportButton.MouseButton1Click:Connect(function()
	local now = os.time()

	if now - lastReport < COOLDOWN then
		status.Text =
			"Report cooldown: " ..
			formatTime(COOLDOWN - (now - lastReport))
		return
	end

	local text = clean(reportBox.Text)

	if text == "" then
		status.Text = "Please describe the issue."
		return
	end

	local message =
		"**Player:** " .. player.Name ..
		"\n**UserId:** " .. player.UserId ..
		"\n\n**Issue:**\n" ..
		text:sub(1, 3500)

	if sendWebhook("New Issue Report", message) then
		lastReport = now
		reportBox.Text = ""
		status.Text = "Report sent! 12-hour cooldown."
	else
		status.Text = "Failed to send report."
	end
end)

