local function makeLabel(text, height)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -10, 0, height)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(220, 225, 235)
	label.Font = Enum.Font.Gotham
	label.TextSize = 13
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Parent = scroll
	return label
end

local function makeBox(placeholder, height)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -10, 0, height)
	box.BackgroundColor3 = Color3.fromRGB(34, 40, 54)
	box.BorderSizePixel = 0
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = Color3.fromRGB(140, 145, 155)
	box.TextColor3 = Color3.new(1, 1, 1)
	box.Font = Enum.Font.Gotham
	box.TextSize = 13
	box.TextWrapped = true
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.TextYAlignment = Enum.TextYAlignment.Top
	box.MultiLine = true
	box.ClearTextOnFocus = false
	box.Parent = scroll

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 9)
	c.Parent = box

	return box
end

