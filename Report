local function createCard(titleText, placeholder, buttonText, explanation, cardHeight)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, -4, 0, cardHeight)
	card.BackgroundColor3 = Color3.fromRGB(22, 32, 49)
	card.BorderSizePixel = 0
	card.Parent = scroll

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 9)
	c.Parent = card

	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(40, 75, 115)
	s.Thickness = 1
	s.Parent = card

	local heading = Instance.new("TextLabel")
	heading.Position = UDim2.fromOffset(8, 6)
	heading.Size = UDim2.new(1, -16, 0, 20)
	heading.BackgroundTransparency = 1
	heading.Text = titleText
	heading.TextColor3 = Color3.fromRGB(100, 180, 255)
	heading.Font = Enum.Font.GothamBold
	heading.TextSize = 12
	heading.TextXAlignment = Enum.TextXAlignment.Left
	heading.Parent = card

	local box = Instance.new("TextBox")
	box.Position = UDim2.fromOffset(8, 29)
	box.Size = UDim2.new(1, -16, 0, 62)
	box.BackgroundColor3 = Color3.fromRGB(12, 19, 30)
	box.BorderSizePixel = 0
	box.Text = ""
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = Color3.fromRGB(135,145,160)
	box.TextColor3 = Color3.fromRGB(255,255,255)
	box.Font = Enum.Font.Gotham
	box.TextSize = 10
	box.TextWrapped = true
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.TextYAlignment = Enum.TextYAlignment.Top
	box.ClearTextOnFocus = false
	box.MultiLine = true
	box.Parent = card

	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0, 6)
	bc.Parent = box

	local send = Instance.new("TextButton")
	send.Position = UDim2.fromOffset(8, 96)
	send.Size = UDim2.new(1, -16, 0, 25)
	send.BackgroundColor3 = Color3.fromRGB(35, 105, 190)
	send.BorderSizePixel = 0
	send.Text = buttonText
	send.TextColor3 = Color3.fromRGB(255,255,255)
	send.Font = Enum.Font.GothamBold
	send.TextSize = 10
	send.Parent = card

	local sbc = Instance.new("UICorner")
	sbc.CornerRadius = UDim.new(0, 6)
	sbc.Parent = send

	local info = Instance.new("TextLabel")
	info.Position = UDim2.fromOffset(8, 124)
	info.Size = UDim2.new(1, -16, 0, 25)
	info.BackgroundTransparency = 1
	info.Text = explanation
	info.TextColor3 = Color3.fromRGB(150,160,175)
	info.Font = Enum.Font.Gotham
	info.TextSize = 8
	info.TextWrapped = true
	info.TextXAlignment = Enum.TextXAlignment.Left
	info.TextYAlignment = Enum.TextYAlignment.Top
	info.Parent = card

	send.MouseButton1Click:Connect(function()
		local text = box.Text:gsub("^%s+", ""):gsub("%s+$", "")

		if text == "" then
			info.Text = "Please enter something first."
			info.TextColor3 = Color3.fromRGB(255,100,100)
			return
		end

		local now = os.time()
		local remaining = COOLDOWN - (now - lastUsed[buttonText])

		if remaining > 0 then
			local hours = math.floor(remaining / 3600)
			local minutes = math.floor((remaining % 3600) / 60)
			info.Text = "Cooldown: " .. hours .. "h " .. minutes .. "m"
			info.TextColor3 = Color3.fromRGB(255,180,80)
			return
		end

		lastUsed[buttonText] = now

		local requestFunction = request or http_request or (syn and syn.request)

		if not requestFunction then
			info.Text = "HTTP request is not supported."
			info.TextColor3 = Color3.fromRGB(255,100,100)
			return
		end

		local body = HttpService:JSONEncode({
			username = "Report System",
			embeds = {{
				title = titleText,
				description = text,
				color = 5793266,
				fields = {
					{
						name = "Username",
						value = player.Name,
						inline = true
					},
					{
						name = "UserId",
						value = tostring(player.UserId),
						inline = true
					},
					{
						name = "Type",
						value = titleText,
						inline = true
					}
				}
			}}
		})

		local success = pcall(function()
			requestFunction({
				Url = WEBHOOK_URL,
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json"
				},
				Body = body
			})
		end)

		if success then
			box.Text = ""
			info.Text = "Sent successfully. Thank you!"
			info.TextColor3 = Color3.fromRGB(100,220,140)
		else
			info.Text = "Failed to send."
			info.TextColor3 = Color3.fromRGB(255,100,100)
		end
	end)
end

