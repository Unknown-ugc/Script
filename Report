local function createCard(data)

	local card = Instance.new("Frame")
	card.Name = data.Name
	card.Size = UDim2.new(1, -4, 0, 205)
	card.BackgroundColor3 = Color3.fromRGB(17, 27, 45)
	card.BorderSizePixel = 0
	card.LayoutOrder = data.Order
	card.Parent = scroll

	corner(card, 11)

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = Color3.fromRGB(45, 95, 180)
	cardStroke.Thickness = 1
	cardStroke.Transparency = 0.2
	cardStroke.Parent = card

	-- CARD TITLE
	local cardTitle = Instance.new("TextLabel")
	cardTitle.Size = UDim2.new(1, -16, 0, 25)
	cardTitle.Position = UDim2.fromOffset(8, 5)
	cardTitle.BackgroundTransparency = 1
	cardTitle.Text = data.Title
	cardTitle.Font = Enum.Font.GothamBold
	cardTitle.TextSize = 12
	cardTitle.TextColor3 = Color3.fromRGB(235, 242, 255)
	cardTitle.TextXAlignment = Enum.TextXAlignment.Left
	cardTitle.Parent = card

	-- TEXTBOX
	local box = Instance.new("TextBox")
	box.Name = "TextBox"
	box.Size = UDim2.new(1, -16, 0, 82)
	box.Position = UDim2.fromOffset(8, 34)
	box.BackgroundColor3 = Color3.fromRGB(24, 36, 57)
	box.BorderSizePixel = 0
	box.ClearTextOnFocus = false
	box.MultiLine = true
	box.TextWrapped = true
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.TextYAlignment = Enum.TextYAlignment.Top
	box.Font = Enum.Font.Gotham
	box.TextSize = 10
	box.TextColor3 = Color3.fromRGB(230, 235, 245)
	box.PlaceholderColor3 = Color3.fromRGB(145, 158, 180)

	-- EXPLANATION + EXAMPLE INSIDE TEXTBOX
	box.PlaceholderText = data.Placeholder

	box.Text = ""
	box.Parent = card

	corner(box, 8)

	-- SEND BUTTON
	local send = Instance.new("TextButton")
	send.Size = UDim2.new(1, -16, 0, 28)
	send.Position = UDim2.fromOffset(8, 122)
	send.BackgroundColor3 = Color3.fromRGB(40, 105, 220)
	send.BorderSizePixel = 0
	send.Text = data.Button
	send.Font = Enum.Font.GothamBold
	send.TextSize = 10
	send.TextColor3 = Color3.new(1, 1, 1)
	send.Parent = card

	corner(send, 7)

	-- EXPLANATION BELOW BUTTON
	local explanation = Instance.new("TextLabel")
	explanation.Size = UDim2.new(1, -16, 0, 42)
	explanation.Position = UDim2.fromOffset(8, 157)
	explanation.BackgroundTransparency = 1
	explanation.Text = data.Explanation
	explanation.Font = Enum.Font.Gotham
	explanation.TextSize = 9
	explanation.TextColor3 = Color3.fromRGB(155, 170, 195)
	explanation.TextWrapped = true
	explanation.TextXAlignment = Enum.TextXAlignment.Left
	explanation.TextYAlignment = Enum.TextYAlignment.Top
	explanation.Parent = card

	-- SEND
	send.MouseButton1Click:Connect(function()

		local message = box.Text

		if message == "" or #message < 3 then
			explanation.Text = "Please enter something first."
			explanation.TextColor3 = Color3.fromRGB(255, 100, 100)
			return
		end

		local now = os.time()
		local last = lastUsed[data.Type]

		if now - last < COOLDOWN then

			local remaining = COOLDOWN - (now - last)

			local hours = math.floor(remaining / 3600)
			local minutes = math.floor((remaining % 3600) / 60)

			explanation.Text =
				"12 hour cooldown. Remaining: "
				.. hours .. "h "
				.. minutes .. "m"

			explanation.TextColor3 =
				Color3.fromRGB(255, 180, 80)

			return
		end

		local requestFunction =
			request
			or http_request
			or (syn and syn.request)

		if not requestFunction then
			explanation.Text = "HTTP request is unavailable."
			explanation.TextColor3 =
				Color3.fromRGB(255, 100, 100)
			return
		end

		if WEBHOOK_URL == ""
			or WEBHOOK_URL == "PASTE_YOUR_WEBHOOK_HERE" then

			explanation.Text = "Webhook URL is not configured."
			explanation.TextColor3 =
				Color3.fromRGB(255, 100, 100)
			return
		end

		send.Text = "SENDING..."
		send.Active = false

		local body = HttpService:JSONEncode({
			username = "Report System",

			embeds = {{
				title = data.Title,
				description = message,
				color = 5793266,

				fields = {
					{
						name = "Username",
						value = player.Name,
						inline = true
					},

					{
						name = "UserId",
						value = tostring(player.UserId),
						inline = true
					},

					{
						name = "Type",
						value = data.Type,
						inline = true
					}
				}
			}}
		})

		local success = pcall(function()
			requestFunction({
				Url = WEBHOOK_URL,
				Method = "POST",

				Headers = {
					["Content-Type"] = "application/json"
				},

				Body = body
			})
		end)

		if success then

			lastUsed[data.Type] = os.time()

			box.Text = ""

			send.Text = "SENT ✓"

			explanation.Text =
				"Sent successfully. You can send again after 12 hours."

			explanation.TextColor3 =
				Color3.fromRGB(100, 220, 140)

			task.delay(3, function()

				if send.Parent then
					send.Text = data.Button
					send.Active = true
					explanation.Text = data.Explanation
					explanation.TextColor3 =
						Color3.fromRGB(155, 170, 195)
				end

			end)

		else

			send.Text = data.Button
			send.Active = true

			explanation.Text =
				"Failed to send. Please try again."

			explanation.TextColor3 =
				Color3.fromRGB(255, 100, 100)
		end
	end)
end

