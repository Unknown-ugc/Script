local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

local function timeLeft(seconds)
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	return h .. "h " .. m .. "m"
end

local function sendWebhook(titleText, description)
	if WEBHOOK_URL == "PASTE_YOUR_WEBHOOK_HERE" then
		status.Text = "Webhook not configured."
		return false
	end

	local data = {
		username = "Report & Script Center",
		embeds = {{
			title = titleText,
			description = description,
			color = 5793266,
			timestamp = DateTime.now():ToIsoDate()
		}}
	}

	local ok = pcall(function()
		HttpService:RequestAsync({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = HttpService:JSONEncode(data)
		})
	end)

	return ok
end

reportButton.MouseButton1Click:Connect(function()
	local now = os.time()

	if now - lastReport < COOLDOWN then
		status.Text = "Report cooldown: " .. timeLeft(COOLDOWN - (now - lastReport))
		return
	end

	local text = reportBox.Text:gsub("^%s+", ""):gsub("%s+$", "")

	if text == "" then
		status.Text = "Please describe the issue."
		return
	end

	local message =
		"**Player:** " .. player.Name ..
		"\n**UserId:** " .. player.UserId ..
		"\n\n**Issue:**\n" .. text:sub(1, 3500)

	if sendWebhook("New Issue Report", message) then
		lastReport = now
		reportBox.Text = ""
		status.Text = "Report sent! Cooldown: 12 hours."
	else
		status.Text = "Failed to send report."
	end
end)

