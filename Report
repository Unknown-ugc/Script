-- TIME FORMAT
local function formatTime(seconds)
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)

	return hours .. "h " .. minutes .. "m"
end

-- DISCORD
local function sendDiscord(titleText, description)
	if WEBHOOK_URL == "PASTE_YOUR_WEBHOOK_HERE" then
		status.Text = "⚠️ Webhook not configured."
		return false
	end

	local data = {
		username = "Roblox Report System",
		embeds = {{
			title = titleText,
			description = description,
			color = 5793266,
			timestamp = DateTime.now():ToIsoDate()
		}}
	}

	local success = pcall(function()
		HttpService:RequestAsync({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = HttpService:JSONEncode(data)
		})
	end)

	return success
end

-- SEND REPORT
sendReport.MouseButton1Click:Connect(function()
	local now = os.time()

	if now - lastReport < COOLDOWN then
		local remaining = COOLDOWN - (now - lastReport)
		status.Text = "⏳ Report cooldown: " .. formatTime(remaining)
		return
	end

	local issue = issueBox.Text:gsub("^%s+", ""):gsub("%s+$", "")

	if issue == "" then
		status.Text = "⚠️ Describe the issue first."
		return
	end

	local message =
		"**Player:** " .. player.Name ..
		"\n**UserId:** " .. player.UserId ..
		"\n\n**Issue:**\n" .. issue:sub(1, 3500)

	local success = sendDiscord("📤 New Issue Report", message)

	if success then
		lastReport = now
		issueBox.Text = ""
		status.Text = "✅ Report sent! 12-hour cooldown."
	else
		status.Text = "❌ Failed to send report."
	end
end)

