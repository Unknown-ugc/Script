local panels = {}

local function makeCorner(object, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = object
end

local function makeStroke(object)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(55, 120, 255)
	stroke.Thickness = 1
	stroke.Transparency = 0.15
	stroke.Parent = object
end

local function makeDraggable(frame, handle)
	local dragging = false
	local dragStart
	local startPosition

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPosition = frame.Position
		end
	end)

	handle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)

	handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			input.Changed:Connect(function()
				if dragging then
					local delta = input.Position - dragStart

					frame.Position = UDim2.new(
						startPosition.X.Scale,
						startPosition.X.Offset + delta.X,
						startPosition.Y.Scale,
						startPosition.Y.Offset + delta.Y
					)
				end
			end)
		end
	end)
end

local function sendWebhook(title, message, typeName)
	local requestFunction =
		request
		or http_request
		or (syn and syn.request)

	if not requestFunction then
		return false, "HTTP request is unavailable."
	end

	if WEBHOOK_URL == ""
		or WEBHOOK_URL == "PASTE_YOUR_WEBHOOK_HERE" then

		return false, "Webhook URL is not configured."
	end

	local body = HttpService:JSONEncode({
		username = "Report Center",
		embeds = {{
			title = title,
			description = message,
			color = 5793266,

			fields = {
				{
					name = "Username",
					value = player.Name,
					inline = true
				},

				{
					name = "UserId",
					value = tostring(player.UserId),
					inline = true
				},

				{
					name = "Type",
					value = typeName,
					inline = true
				}
			}
		}}
	})

	local success = pcall(function()
		requestFunction({
			Url = WEBHOOK_URL,
			Method = "POST",

			Headers = {
				["Content-Type"] = "application/json"
			},

			Body = body
		})
	end)

	if success then
		return true
	end

	return false, "Failed to send."
end

local function formatCooldown(seconds)
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)

	return hours .. "h " .. minutes .. "m"
end

local function createPanel(data)

	local frame = Instance.new("Frame")
	frame.Name = data.Name

	frame.Size = UDim2.fromOffset(235, 205)
	frame.Position = data.Position

	frame.BackgroundColor3 = Color3.fromRGB(15, 22, 35)
	frame.BorderSizePixel = 0

	frame.Parent = gui

	makeCorner(frame, 12)
	makeStroke(frame)

	panels[data.Type] = frame

	local title = Instance.new("TextLabel")
	title.Name = "Title"

	title.Size = UDim2.new(1, -16, 0, 30)
	title.Position = UDim2.fromOffset(8, 5)

	title.BackgroundTransparency = 1

	title.Font = Enum.Font.GothamBold
	title.TextSize = 13
	title.TextColor3 = Color3.fromRGB(235, 242, 255)

	title.Text = data.Title
	title.TextXAlignment = Enum.TextXAlignment.Left

	title.Parent = frame

	local box = Instance.new("TextBox")
	box.Name = "Input"

	box.Size = UDim2.new(1, -16, 0, 82)
	box.Position = UDim2.fromOffset(8, 40)

	box.BackgroundColor3 = Color3.fromRGB(25, 34, 52)
	box.BorderSizePixel = 0

	box.ClearTextOnFocus = false
	box.MultiLine = true
	box.TextWrapped = true

	box.TextXAlignment = Enum.TextXAlignment.Left
	box.TextYAlignment = Enum.TextYAlignment.Top

	box.Font = Enum.Font.Gotham
	box.TextSize = 10

	box.TextColor3 = Color3.fromRGB(230, 235, 245)
	box.PlaceholderColor3 = Color3.fromRGB(145, 158, 180)

	box.PlaceholderText = data.Placeholder
	box.Text = ""

	box.Parent = frame

	makeCorner(box, 8)

	local send = Instance.new("TextButton")
	send.Name = "Send"

	send.Size = UDim2.new(1, -16, 0, 28)
	send.Position = UDim2.fromOffset(8, 128)

	send.BackgroundColor3 = Color3.fromRGB(40, 105, 220)
	send.BorderSizePixel = 0

	send.Font = Enum.Font.GothamBold
	send.TextSize = 10
	send.TextColor3 = Color3.new(1, 1, 1)

	send.Text = data.Button

	send.Parent = frame

	makeCorner(send, 7)

	local explanation = Instance.new("TextLabel")
	explanation.Name = "Explanation"

	explanation.Size = UDim2.new(1, -16, 0, 38)
	explanation.Position = UDim2.fromOffset(8, 162)

	explanation.BackgroundTransparency = 1

	explanation.Font = Enum.Font.Gotham
	explanation.TextSize = 9
	explanation.TextColor3 = Color3.fromRGB(155, 170, 195)

	explanation.TextWrapped = true

	explanation.TextXAlignment = Enum.TextXAlignment.Left
	explanation.TextYAlignment = Enum.TextYAlignment.Top

	explanation.Text = data.Explanation

	explanation.Parent = frame

	makeDraggable(frame, title)

	send.MouseButton1Click:Connect(function()

		local message = box.Text

		if message == "" or #message < 3 then

			explanation.Text = "Please enter more information."
			explanation.TextColor3 = Color3.fromRGB(255, 100, 100)

			return
		end

		local now = os.time()
		local last = cooldowns[data.Type]

		if now - last < COOLDOWN then

			local remaining = COOLDOWN - (now - last)

			explanation.Text =
				"Cooldown active: "
				.. formatCooldown(remaining)
				.. " remaining."

			explanation.TextColor3 =
				Color3.fromRGB(255, 180, 80)

			return
		end

		send.Text = "SENDING..."
		send.Active = false

		local success, result =
			sendWebhook(
				data.Title,
				message,
				data.Type
			)

		if success then

			cooldowns[data.Type] = os.time()

			box.Text = ""

			send.Text = "SENT ✓"

			explanation.Text =
				"Sent successfully! You can submit again in 12 hours."

			explanation.TextColor3 =
				Color3.fromRGB(100, 220, 140)

			task.delay(3, function()

				if send.Parent then
					send.Text = data.Button

					explanation.Text =
						data.Explanation

					explanation.TextColor3 =
						Color3.fromRGB(155, 170, 195)

					send.Active = true
				end

			end)

		else

			send.Text = data.Button
			send.Active = true

			explanation.Text = result
			explanation.TextColor3 =
				Color3.fromRGB(255, 100, 100)

		end
	end)

	return frame
end

