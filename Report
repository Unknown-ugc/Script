local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer

local WEBHOOK_URL = "https://discord.com/api/webhooks/1547588055450521650/sst9fMdf8Q3aGmiXBTNv5yt4z9OLRse1377npW3rlAsBanvFPb6M1VuWpLJQbZ3R6bR8"

local COOLDOWN = 12 * 60 * 60

local cooldowns = {
	Report = 0,
	Suggestion = 0,
	Script = 0
}

local gui = Instance.new("ScreenGui")
