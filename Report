-- DISCORD FUNCTION
local function sendDiscord(titleText, description)
	if WEBHOOK_URL == "PASTE_YOUR_WEBHOOK_HERE" then
		status.Text = "⚠️ Webhook is not configured."
		return
	end

	local data = {
		username = "Roblox Report System",
		embeds = {{
			title = titleText,
			description = description,
			color = 5793266,
			timestamp = DateTime.now():ToIsoDate()
		}}
	}

	local success = pcall(function()
		HttpService:RequestAsync({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = HttpService:JSONEncode(data)
		})
	end)

	if success then
		status.Text = "✅ Sent successfully!"
	else
		status.Text = "❌ Failed to send report."
	end
end

