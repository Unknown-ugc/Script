--========================================================
-- CREATE SHADER BUTTONS
--========================================================

local ShaderOrder = {

	"🌅 Morning",
	"☀️ Day",
	"🌤️ Cloudy Day",
	"🌇 Sunset",
	"🌆 Golden Hour",
	"🌙 Night",
	"🌌 Midnight",
	"🌃 Moonlight",
	"🌧️ Rainy",
	"🌫️ Foggy",
	"❄️ Winter",
	"🌲 Forest",
	"🌊 Ocean",
	"🎬 Cinematic",
	"✨ Ultra Realistic",
	"🌈 Vibrant",
}

local function SetButtonSelected(Name, Selected)

	local Button = Buttons[Name]

	if not Button then
		return
	end

	local Stroke = Button:FindFirstChild("ButtonStroke")

	if Selected then

		Button.BackgroundColor3 =
			Color3.fromRGB(24, 70, 115)

		if Stroke then
			Stroke.Color =
				Color3.fromRGB(55, 165, 255)

			Stroke.Transparency = 0
		end

	else

		Button.BackgroundColor3 =
			Color3.fromRGB(18, 29, 45)

		if Stroke then
			Stroke.Color =
				Color3.fromRGB(45, 75, 105)

			Stroke.Transparency = 0.45
		end

	end

end

for Index, Name in ipairs(ShaderOrder) do

	local Button = Instance.new("TextButton")

	Button.Name = "Shader_" .. Index

	Button.Size = UDim2.new(1, 0, 0, 34)

	Button.BackgroundColor3 =
		Color3.fromRGB(18, 29, 45)

	Button.BorderSizePixel = 0

	Button.Text = ""

	Button.AutoButtonColor = false

	Button.LayoutOrder = Index

	Button.Parent = Scroll

	local Corner = Instance.new("UICorner")

	Corner.CornerRadius = UDim.new(0, 9)

	Corner.Parent = Button

	local Stroke = Instance.new("UIStroke")

	Stroke.Name = "ButtonStroke"

	Stroke.Color =
		Color3.fromRGB(45, 75, 105)

	Stroke.Thickness = 1

	Stroke.Transparency = 0.45

	Stroke.Parent = Button

	local Label = Instance.new("TextLabel")

	Label.BackgroundTransparency = 1

	Label.Size = UDim2.new(1, -45, 1, 0)

	Label.Position = UDim2.new(0, 12, 0, 0)

	Label.Font = Enum.Font.GothamMedium

	Label.Text = Name

	Label.TextColor3 =
		Color3.fromRGB(220, 230, 240)

	Label.TextSize = 11

	Label.TextXAlignment =
		Enum.TextXAlignment.Left

	Label.Parent = Button

	local Check = Instance.new("TextLabel")

	Check.Name = "Check"

	Check.BackgroundTransparency = 1

	Check.Size = UDim2.new(0, 25, 1, 0)

	Check.Position = UDim2.new(1, -32, 0, 0)

	Check.Font = Enum.Font.GothamBold

	Check.Text = ""

	Check.TextColor3 =
		Color3.fromRGB(90, 190, 255)

	Check.TextSize = 14

	Check.Parent = Button

	Buttons[Name] = Button

	Button.Activated:Connect(function()

		local CurrentTime = os.clock()

		-- Double tap currently selected shader
		if SelectedName == Name
			and CurrentTime - LastTap <= 0.45 then

			SelectedName = nil

			for ShaderName, OtherButton in pairs(Buttons) do

				SetButtonSelected(
					ShaderName,
					false
				)

				local OtherCheck =
					OtherButton:FindFirstChild("Check")

				if OtherCheck then
					OtherCheck.Text = ""
				end

			end

			RestoreNormal()

			LastTap = 0

			return
		end

		LastTap = CurrentTime

		SelectedName = Name

		for ShaderName, OtherButton in pairs(Buttons) do

			local IsSelected =
				ShaderName == Name

			SetButtonSelected(
				ShaderName,
				IsSelected
			)

			local OtherCheck =
				OtherButton:FindFirstChild("Check")

			if OtherCheck then

				if IsSelected then
					OtherCheck.Text = "✓"
				else
					OtherCheck.Text = ""
				end

			end

		end

		ApplyShader(Name)

	end)

end

