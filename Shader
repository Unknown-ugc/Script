		end
	end
end

local function copyText(text, button, originalText)
	if typeof(setclipboard) == "function" then
		pcall(function()
			setclipboard(text)
		end)

		button.Text = "Copied!"

		task.delay(1.2, function()
			if button and button.Parent then
				button.Text = originalText
			end
		end)
	end
end

