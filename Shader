--------------------------------------------------
-- APPLY SHADER
--------------------------------------------------

local function applyShader(shader)

	removeChrisEffects()

	Lighting.ClockTime = shader.time
	Lighting.Brightness = shader.brightness
	Lighting.ExposureCompensation = shader.exposure
	Lighting.Ambient = shader.ambient
	Lighting.OutdoorAmbient = shader.outdoor
	Lighting.GlobalShadows = true

	local color = newEffect("ColorCorrectionEffect")

	color.Saturation = 0.08
	color.Contrast = 0.08

	if shader.name == "Vibrant" then
		color.Saturation = 0.35
		color.Contrast = 0.12

	elseif shader.name == "Cinematic" then
		color.Saturation = -0.05
		color.Contrast = 0.22

	elseif shader.name == "Night"
		or shader.name == "Midnight"
		or shader.name == "Moonlight" then

		color.Saturation = -0.05
		color.Contrast = 0.12
		color.TintColor = Color3.fromRGB(180,195,255)
	end

	local atmosphere = newEffect("Atmosphere")

	atmosphere.Density = 0.12
	atmosphere.Offset = 0.15
	atmosphere.Glare = 0.05
	atmosphere.Haze = 0.4

	if shader.name == "Foggy" then

		atmosphere.Density = 0.35
		atmosphere.Haze = 1

		Lighting.FogColor = Color3.fromRGB(185,195,205)
		Lighting.FogStart = 20
		Lighting.FogEnd = 350

	elseif shader.name == "Night"
		or shader.name == "Midnight"
		or shader.name == "Moonlight" then

		atmosphere.Density = 0.08
		atmosphere.Haze = 0.2

	else

		Lighting.FogStart = original.FogStart
		Lighting.FogEnd = original.FogEnd
	end
end

