local function RestoreOriginalSky()

	RemoveSkies()

	for _, sky in ipairs(OriginalSkies) do

		local Clone = sky:Clone()
		Clone.Parent = Lighting

	end

end

--========================================================
-- APPLY SKYBOX
--========================================================

local function ApplySkybox(SkyData)

	if not SkyData then
		RestoreOriginalSky()
		return
	end

	RemoveSkies()

	local Sky = Instance.new("Sky")

	Sky.Name = "ChrisShaderSky"

	Sky.SkyboxBk = SkyData.Bk
	Sky.SkyboxDn = SkyData.Dn
	Sky.SkyboxFt = SkyData.Ft
	Sky.SkyboxLf = SkyData.Lf
	Sky.SkyboxRt = SkyData.Rt
	Sky.SkyboxUp = SkyData.Up

	Sky.CelestialBodiesShown = true
	Sky.StarCount = 3000

	Sky.Parent = Lighting

end

--========================================================
-- APPLY SHADER
--========================================================

local function ApplyShader(Name)

	local Data = Shaders[Name]

	if not Data then
		return
	end

	-- Lighting

	Lighting.ClockTime = Data.ClockTime
	Lighting.Brightness = Data.Brightness
	Lighting.ExposureCompensation = Data.Exposure

	Lighting.Ambient = Data.Ambient
	Lighting.OutdoorAmbient = Data.Outdoor

	Lighting.FogStart = Data.FogStart
	Lighting.FogEnd = Data.FogEnd
	Lighting.FogColor = Data.FogColor

	-- Color Correction

	ColorEffect.Enabled = true

	ColorEffect.Brightness = Data.CCBrightness
	ColorEffect.Contrast = Data.Contrast
	ColorEffect.Saturation = Data.Saturation
	ColorEffect.TintColor = Data.Tint

	-- Bloom

	BloomEffect.Enabled = true

	BloomEffect.Intensity = Data.Bloom
	BloomEffect.Size = Data.BloomSize
	BloomEffect.Threshold = Data.BloomThreshold

	-- Skybox

	ApplySkybox(Skyboxes[Name])

	-- Special effects

	if Data.Effect == "Rain" then

		CreateRain()

	elseif Data.Effect == "Snow" then

		CreateSnow()

	else

		ClearWorldEffects()

	end

end

