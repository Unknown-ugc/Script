--==================================================
-- APPLY SHADER
--==================================================

local function applyShader(data)

	clearEffects()

	Lighting.ClockTime = data.clock
	Lighting.Brightness = data.brightness
	Lighting.ExposureCompensation = data.exposure
	Lighting.Ambient = data.ambient
	Lighting.OutdoorAmbient = data.outdoor
	Lighting.GlobalShadows = true

	local color = effect("ColorCorrectionEffect")

	if data.name == "Vibrant" then
		color.Saturation = 0.35
		color.Contrast = 0.12
	elseif data.name == "Cinematic" then
		color.Saturation = -0.05
		color.Contrast = 0.22
	elseif data.name == "Night"
		or data.name == "Midnight"
		or data.name == "Moonlight" then

		color.Saturation = -0.05
		color.Contrast = 0.12
		color.TintColor = Color3.fromRGB(180, 195, 255)
	else
		color.Saturation = 0.08
		color.Contrast = 0.08
	end

	if data.fog then
		Lighting.FogColor = Color3.fromRGB(185, 195, 205)
		Lighting.FogStart = 20
		Lighting.FogEnd = 350
	else
		Lighting.FogStart = original.FogStart
		Lighting.FogEnd = original.FogEnd
	end

	local atmosphere = effect("Atmosphere")
	atmosphere.Density = 0.12
	atmosphere.Offset = 0.15
	atmosphere.Glare = 0.05
	atmosphere.Haze = 0.4

	if data.name == "Foggy" then
		atmosphere.Density = 0.35
		atmosphere.Haze = 1
	elseif data.name == "Night"
		or data.name == "Midnight"
		or data.name == "Moonlight" then

		atmosphere.Density = 0.08
		atmosphere.Haze = 0.2
	end
end

