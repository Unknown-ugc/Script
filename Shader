--========================================================
-- CREATE RAIN
--========================================================

local function CreateRain()

	ClearWorldEffects()

	local Character = Player.Character

	if not Character then
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return
	end

	local RainFolder = Instance.new("Folder")
	RainFolder.Name = "Rain"
	RainFolder.Parent = EffectFolder

	local Drops = {}

	for i = 1, 120 do

		local Drop = Instance.new("Part")
		Drop.Name = "RainDrop"
		Drop.Anchored = true
		Drop.CanCollide = false
		Drop.CanTouch = false
		Drop.CanQuery = false
		Drop.CastShadow = false

		Drop.Material = Enum.Material.Neon
		Drop.Color = Color3.fromRGB(185, 210, 235)

		local width = 0.025
		local length = math.random(25, 55) / 100

		Drop.Size = Vector3.new(width, length, width)

		Drop.Parent = RainFolder

		table.insert(Drops, {
			Part = Drop,
			Offset = Vector3.new(
				math.random(-35, 35),
				math.random(0, 30),
				math.random(-35, 35)
			),
			Speed = math.random(45, 75),
		})

	end

	EffectConnection = RunService.RenderStepped:Connect(function(dt)

		if not Root.Parent then
			return
		end

		local rootPosition = Root.Position

		for _, data in ipairs(Drops) do

			local Drop = data.Part

			if Drop.Parent then

				local current = Drop.Position

				current = current - Vector3.new(
					1.5 * dt,
					data.Speed * dt,
					0.5 * dt
				)

				if current.Y < rootPosition.Y - 15 then

					current = rootPosition
						+ data.Offset
						+ Vector3.new(
							0,
							math.random(20, 45),
							0
						)

				end

				Drop.Position = current

			end

		end

	end)

end

--========================================================
-- CREATE SNOW
--========================================================

local function CreateSnow()

	ClearWorldEffects()

	local Character = Player.Character

	if not Character then
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return
	end

	local SnowFolder = Instance.new("Folder")
	SnowFolder.Name = "Snow"
	SnowFolder.Parent = EffectFolder

	local Flakes = {}

	for i = 1, 80 do

		local Flake = Instance.new("Part")

		Flake.Name = "SnowFlake"
		Flake.Anchored = true
		Flake.CanCollide = false
		Flake.CanTouch = false
		Flake.CanQuery = false
		Flake.CastShadow = false

		Flake.Shape = Enum.PartType.Ball
		Flake.Material = Enum.Material.Neon
		Flake.Color = Color3.fromRGB(245, 250, 255)

		local size = math.random(5, 12) / 100

		Flake.Size = Vector3.new(size, size, size)

		Flake.Parent = SnowFolder

		table.insert(Flakes, {
			Part = Flake,
			Offset = Vector3.new(
				math.random(-35, 35),
				math.random(0, 35),
				math.random(-35, 35)
			),
			Speed = math.random(3, 8),
			Wave = math.random() * 10,
		})

	end

	EffectConnection = RunService.RenderStepped:Connect(function(dt)

		if not Root.Parent then
			return
		end

		local rootPosition = Root.Position
		local now = os.clock()

		for _, data in ipairs(Flakes) do

			local Flake = data.Part

			if Flake.Parent then

				local current = Flake.Position

				current = current - Vector3.new(
					math.sin(now + data.Wave) * dt,
					data.Speed * dt,
					math.cos(now + data.Wave) * dt
				)

				if current.Y < rootPosition.Y - 8 then

					current = rootPosition
						+ data.Offset
						+ Vector3.new(
							0,
							math.random(20, 35),
							0
						)

				end

				Flake.Position = current

			end

		end

	end)

end

