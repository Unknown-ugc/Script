local lastTapTime = 0
local DOUBLE_TAP_DELAY = 0.35

local function restoreOriginal()
	resetLighting()
	SelectedPreset = nil
	selectButton(0)
end

for index, button in ipairs(PresetButtons) do
	button.MouseButton1Click:Connect(function()
		local now = os.clock()

		if SelectedPreset == index and now - lastTapTime <= DOUBLE_TAP_DELAY then
			restoreOriginal()
			lastTapTime = 0
			return
		end

		lastTapTime = now

		SelectedPreset = index
		selectButton(index)
		applyPreset(index)
	end)
end

Player.CharacterAdded:Connect(function(newCharacter)
	Character = newCharacter

	task.wait(1)

	if SelectedPreset == 9 then
		createRain()
		startWetGround()
	elseif SelectedPreset == 11 then
		createSnow()
	end
end)

