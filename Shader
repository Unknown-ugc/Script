--------------------------------------------------
-- LIGHTING
--------------------------------------------------

local function updateLighting()

	if not CONFIG.Enabled then
		return
	end

	local night =
		Lighting.ClockTime < 6
		or Lighting.ClockTime >= 18

	if CONFIG.Rain then
		atmosphere.Density = 0.34
		atmosphere.Haze = 2
		atmosphere.Glare = 0.08

		color.Contrast = 0.1
		color.Saturation = -0.04
		color.TintColor = Color3.fromRGB(
			215,
			225,
			245
		)

		bloom.Intensity = 0.2
		sunRays.Intensity = 0.02

	elseif night and CONFIG.DayNight then

		Lighting.Brightness = 0.8
		Lighting.Ambient =
			Color3.fromRGB(55,65,90)

		Lighting.OutdoorAmbient =
			Color3.fromRGB(45,55,80)

		atmosphere.Density = 0.25
		atmosphere.Haze = 1.4

		color.TintColor =
			Color3.fromRGB(205,220,255)

		color.Contrast = 0.08
		color.Saturation = 0.02

		bloom.Intensity = 0.24

	else

		Lighting.Brightness = 2.2

		Lighting.Ambient =
			Color3.fromRGB(120,120,120)

		Lighting.OutdoorAmbient =
			Color3.fromRGB(135,135,135)

		atmosphere.Density = 0.2
		atmosphere.Haze = 1

		color.TintColor =
			Color3.fromRGB(255,255,255)

		color.Contrast = 0.06
		color.Saturation = 0.04

		bloom.Intensity = 0.16
	end

	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25

	pcall(function()
		Lighting.EnvironmentDiffuseScale = 0.7
		Lighting.EnvironmentSpecularScale = 0.8
	end)
end

--------------------------------------------------
-- RAIN
--------------------------------------------------

local rainDrops = {}

local function createRain()

	local drop = Instance.new("Part")

	drop.Name = "RainDrop"
	drop.Anchored = true
	drop.CanCollide = false
	drop.CanTouch = false
	drop.CanQuery = false

	drop.Material = Enum.Material.Neon
	drop.Color = Color3.fromRGB(
		190,
		220,
		255
	)

	drop.Transparency = 1

	drop.Size = Vector3.new(
		0.025,
		math.random(35,65)/100,
		0.025
	)

	drop.Parent = rainFolder

	table.insert(rainDrops,drop)

	return drop
end

for i = 1,CONFIG.RainDrops do
	createRain()
end

local function randomRainPosition()

	local pos = camera.CFrame.Position

	return pos + Vector3.new(
		math.random(
			-CONFIG.RainDistance,
			CONFIG.RainDistance
		),
		math.random(
			20,
			CONFIG.RainHeight
		),
		math.random(
			-CONFIG.RainDistance,
			CONFIG.RainDistance
		)
	)
end

local function showRain(enabled)

	for _,drop in ipairs(rainDrops) do

		if enabled then
			drop.Transparency = 0.35
			drop.Position = randomRainPosition()
		else
			drop.Transparency = 1
		end
	end
end

--------------------------------------------------
-- WET GROUND
--------------------------------------------------

local rayParams = RaycastParams.new()

rayParams.FilterType =
	Enum.RaycastFilterType.Exclude

local function setupRaycastFilter()

	local character = player.Character

	local list = {
		rootFolder
	}

	if character then
		table.insert(list,character)
	end

	rayParams.FilterDescendantsInstances = list
end

setupRaycastFilter()

player.CharacterAdded:Connect(function()

	task.wait(1)

	setupRaycastFilter()

end)

local function makeWet(part)

	if not CONFIG.WetGround then
		return
	end

	if not part:IsA("BasePart") then
		return
	end

	if part:IsDescendantOf(rootFolder) then
		return
	end

	if part.Transparency >= 0.95 then
		return
	end

	if part:IsA("Terrain") then
		return
	end

	if not original[part] then

		original[part] = {
			Reflectance = part.Reflectance,
			Material = part.Material
		}

	end

	wetParts[part] = true

	-- Keep the original material.
	-- Only increase reflectance so the ground
	-- looks wet instead of changing the whole map.

	part.Reflectance =
		math.max(
			part.Reflectance,
			CONFIG.WetReflectance
		)
end

local function restoreWet()

	for part,data in pairs(original) do

		if part and part.Parent then

			part.Reflectance =
				data.Reflectance

			part.Material =
				data.Material
		end
	end

	table.clear(original)
	table.clear(wetParts)
end

local function scanGround()

	if not CONFIG.WetGround then
		return
	end

	setupRaycastFilter()

	local center =
		camera.CFrame.Position

	local amount = 14

	for i = 1,amount do

		local offset = Vector3.new(
			math.random(
				-CONFIG.ScanDistance,
				CONFIG.ScanDistance
			),
			0,
			math.random(
				-CONFIG.ScanDistance,
				CONFIG.ScanDistance
			)
		)

		local origin =
			center
			+ offset
			+ Vector3.new(0,45,0)

		local result =
			workspace:Raycast(
				origin,
				Vector3.new(0,-100,0),
				rayParams
			)

		if result then
			makeWet(result.Instance)
		end
	end
end

--------------------------------------------------
-- WEATHER CONTROL
--------------------------------------------------

local function setRain(enabled)

	CONFIG.Rain = enabled

	-- AUTOMATIC WET GROUND
	if enabled then

		CONFIG.WetGround = true

		showRain(true)

	else

		CONFIG.WetGround = false

		showRain(false)

		restoreWet()
	end

	updateLighting()
end

--------------------------------------------------
-- CLOUDS
--------------------------------------------------

local function updateClouds()

	if CONFIG.Clouds then

		clouds.Enabled = true
		clouds.Cover = CONFIG.Rain and 0.8 or 0.45
		clouds.Density = CONFIG.Rain and 0.75 or 0.35

	else

		clouds.Enabled = false
	end
end

