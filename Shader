local HEADER_HEIGHT = 58
local COLLAPSE_OFFSET = -(MAIN_HEIGHT - HEADER_HEIGHT)
local CLOSE_OFFSET = -500

local function tween(object, properties, duration)
	local info = TweenInfo.new(
		duration,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out
	)

	local animation = TweenService:Create(
		object,
		info,
		properties
	)

	animation:Play()

	return animation
end

local function updateSlide()
	if Closed then
		return
	end

	if Collapsed then
		SlideButton.Text = "▼"

		local target = UDim2.new(
			ExpandedPosition.X.Scale,
			ExpandedPosition.X.Offset,
			ExpandedPosition.Y.Scale,
			ExpandedPosition.Y.Offset + COLLAPSE_OFFSET
		)

		tween(Main, {
			Position = target
		}, 0.35)
	else
		SlideButton.Text = "▲"

		tween(Main, {
			Position = ExpandedPosition
		}, 0.35)
	end
end

SlideButton.MouseButton1Click:Connect(function()
	if Closed then
		return
	end

	Collapsed = not Collapsed
	updateSlide()
end)

CloseButton.MouseButton1Click:Connect(function()
	if Closed then
		return
	end

	Closed = true
	Collapsed = false

	tween(Main, {
		Position = UDim2.new(
			ExpandedPosition.X.Scale,
			ExpandedPosition.X.Offset,
			ExpandedPosition.Y.Scale,
			ExpandedPosition.Y.Offset + CLOSE_OFFSET
		)
	}, 0.4)

	task.delay(0.42, function()
		if Closed then
			Main.Visible = false
			ReopenButton.Visible = true
		end
	end)
end)

ReopenButton.MouseButton1Click:Connect(function()
	Closed = false
