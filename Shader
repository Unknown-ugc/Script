local function getRoot()
	if not Character or not Character.Parent then
		Character = Player.Character
	end

	if not Character then
		return nil
	end

	return Character:FindFirstChild("HumanoidRootPart")
end

local function clearWeather()
	if WeatherConnection then
		WeatherConnection:Disconnect()
		WeatherConnection = nil
	end

	for _, part in ipairs(RainParts) do
		if part and part.Parent then
			part:Destroy()
		end
	end

	for _, part in ipairs(SnowParts) do
		if part and part.Parent then
			part:Destroy()
		end
	end

	table.clear(RainParts)
	table.clear(SnowParts)
end

local function stopWetGround()
	if WetConnection then
		WetConnection:Disconnect()
		WetConnection = nil
	end

	for part, oldReflectance in pairs(WetParts) do
		if part and part.Parent then
			pcall(function()
				part.Reflectance = oldReflectance
			end)
		end
	end

	table.clear(WetParts)

	Lighting.EnvironmentDiffuseScale = Original.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = Original.EnvironmentSpecularScale
end

local function startWetGround()
	stopWetGround()

	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		Character,
		EffectFolder
	}
	params.MaxParts = 250

	local timer = 0

	WetConnection = RunService.Heartbeat:Connect(function(dt)
		timer += dt

		if timer < 1 then
			return
		end

		timer = 0

		local root = getRoot()

		if not root then
			return
		end

		local nearbyParts = workspace:GetPartBoundsInRadius(
			root.Position,
			55,
			params
		)

		for _, part in ipairs(nearbyParts) do
			if part:IsA("BasePart")
				and not part:IsDescendantOf(Character)
				and not part:IsDescendantOf(EffectFolder) then

				if WetParts[part] == nil then
					WetParts[part] = part.Reflectance
				end

				pcall(function()
					part.Reflectance = math.max(
						WetParts[part],
						0.10
					)
				end)
			end
		end
	end)
end

local function createRain()
	clearWeather()

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	for i = 1, 70 do
		local drop = Instance.new("Part")

		drop.Name = "RainDrop"
		drop.Anchored = true
		drop.CanCollide = false
		drop.CanTouch = false
		drop.CanQuery = false
		drop.CastShadow = false
		drop.Material = Enum.Material.Neon
		drop.Color = Color3.fromRGB(185, 225, 255)
		drop.Transparency = 0.08
		drop.Size = Vector3.new(0.045, 2.7, 0.045)

		drop.Position = camera.CFrame.Position + Vector3.new(
			math.random(-38, 38),
			math.random(5, 45),
			math.random(-38, 38)
		)

		drop.Parent = EffectFolder

		table.insert(RainParts, drop)
	end

	WeatherConnection = RunService.RenderStepped:Connect(function(dt)
		local currentCamera = workspace.CurrentCamera

		if not currentCamera then
			return
		end

		local cameraPosition = currentCamera.CFrame.Position

		for _, drop in ipairs(RainParts) do
			if drop and drop.Parent then
				drop.Position += Vector3.new(
					-2.5 * dt,
					-90 * dt,
					-1.5 * dt
				)

				local relative = drop.Position - cameraPosition

				if relative.Y < -7
					or math.abs(relative.X) > 45
					or math.abs(relative.Z) > 45 then

					drop.Position = cameraPosition + Vector3.new(
						math.random(-38, 38),
						math.random(20, 50),
						math.random(-38, 38)
					)
				end
			end
		end
	end)
end

local function createSnow()
	clearWeather()

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	for i = 1, 50 do
		local snow = Instance.new("Part")

		snow.Name = "SnowFlake"
		snow.Shape = Enum.PartType.Ball
		snow.Anchored = true
		snow.CanCollide = false
		snow.CanTouch = false
		snow.CanQuery = false
		snow.CastShadow = false
		snow.Material = Enum.Material.Neon
		snow.Color = Color3.fromRGB(245, 250, 255)
		snow.Transparency = 0.05

		local size = math.random(2, 5) / 100

		snow.Size = Vector3.new(
			size,
			size,
			size
		)

		snow.Position = camera.CFrame.Position + Vector3.new(
			math.random(-38, 38),
			math.random(5, 45),
			math.random(-38, 38)
		)

		snow.Parent = EffectFolder

		table.insert(SnowParts, snow)
	end

	WeatherConnection = RunService.RenderStepped:Connect(function(dt)
		local currentCamera = workspace.CurrentCamera

		if not currentCamera then
			return
		end

		local cameraPosition = currentCamera.CFrame.Position

		for _, snow in ipairs(SnowParts) do
			if snow and snow.Parent then
				local t = os.clock()

				snow.Position += Vector3.new(
					math.sin(t * 1.8 + snow.Position.X) * 0.12 * dt,
					-13 * dt,
					math.cos(t * 1.5 + snow.Position.Z) * 0.12 * dt
				)

				local relative = snow.Position - cameraPosition

				if relative.Y < -7
					or math.abs(relative.X) > 45
					or math.abs(relative.Z) > 45 then

					snow.Position = cameraPosition + Vector3.new(
						math.random(-38, 38),
						math.random(20, 50),
						math.random(-38, 38)
					)
				end
			end
		end
	end)
end

