-- Remove effects created by this script
local function clearEffects()
	for _, obj in ipairs(Lighting:GetChildren()) do
		if obj:GetAttribute("ChrisShader") then
			obj:Destroy()
		end
	end
end

local function effect(className)
	local obj = Instance.new(className)
	obj:SetAttribute("ChrisShader", true)
	obj.Parent = Lighting
	return obj
end

