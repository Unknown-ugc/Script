local ExpandedPosition = Main.Position
local Collapsed = false
local Closed = false

local function SlidePanel()
	if Closed then
		return
	end

	Collapsed = not Collapsed

	local target

	if Collapsed then
		target = UDim2.new(
			ExpandedPosition.X.Scale,
			ExpandedPosition.X.Offset,
			ExpandedPosition.Y.Scale,
			ExpandedPosition.Y.Offset - (Main.AbsoluteSize.Y - 58)
		)

		SlideButton.Text = "▼"
	else
		target = ExpandedPosition
		SlideButton.Text = "▲"
	end

	TweenService:Create(
		Main,
		TweenInfo.new(0.35,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
		{Position = target}
	):Play()
end

SlideButton.MouseButton1Click:Connect(SlidePanel)

CloseButton.MouseButton1Click:Connect(function()
	Closed = true

	TweenService:Create(
		Main,
		TweenInfo.new(0.3,Enum.EasingStyle.Quint,Enum.EasingDirection.In),
		{
			Position = UDim2.new(
				ExpandedPosition.X.Scale,
				ExpandedPosition.X.Offset,
				ExpandedPosition.Y.Scale,
				-500
			)
		}
	):Play()

	task.delay(0.3,function()
		Main.Visible = false
		Reopen.Visible = true
	end)
end)

Reopen.MouseButton1Click:Connect(function()
	Closed = false
	Collapsed = false

	Main.Visible = true
	Reopen.Visible = false
	SlideButton.Text = "▲"

	Main.Position = UDim2.new(
		ExpandedPosition.X.Scale,
		ExpandedPosition.X.Offset,
		ExpandedPosition.Y.Scale,
		-500
	)

	TweenService:Create(
		Main,
		TweenInfo.new(0.35,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
		{Position = ExpandedPosition}
	):Play()
end)

local dragging = false
local dragStart
local startPosition

Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		if input.Position.X > Header.AbsolutePosition.X + Header.AbsoluteSize.X - 105 then
			return
		end

		if Collapsed or Closed then
			return
		end

		dragging = true
		dragStart = input.Position
		startPosition = Main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				ExpandedPosition = Main.Position
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		Main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

