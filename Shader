local function ClearWeather()
	if WeatherConnection then
		WeatherConnection:Disconnect()
		WeatherConnection = nil
	end

	for _, p in ipairs(WeatherParts) do
		if p and p.Parent then
			p:Destroy()
		end
	end

	table.clear(WeatherParts)
end

local function CreateRain()
	ClearWeather()

	for i = 1, 40 do
		local p = Instance.new("Part")
		p.Name = "RainDrop"
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(190,210,255)
		p.Transparency = 0.4
		p.Size = Vector3.new(0.035,2.2,0.035)
		p.Parent = EffectFolder
		table.insert(WeatherParts,p)
	end

	WeatherConnection = RunService.RenderStepped:Connect(function(dt)
		local character = Player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")

		if not root then
			return
		end

		for _, p in ipairs(WeatherParts) do
			if p.Parent then
				if p.Position.Y < root.Position.Y - 5 then
					p.Position = root.Position + Vector3.new(
						math.random(-30,30),
						math.random(20,35),
						math.random(-30,30)
					)
				else
					p.CFrame = p.CFrame + Vector3.new(0,-55 * dt,0)
				end
			end
		end
	end)
end

local function CreateSnow()
	ClearWeather()

	for i = 1, 30 do
		local p = Instance.new("Part")
		p.Name = "Snow"
		p.Shape = Enum.PartType.Ball
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(245,250,255)
		p.Transparency = 0.15

		local s = math.random(2,4) / 10
		p.Size = Vector3.new(s,s,s)
		p.Parent = EffectFolder

		table.insert(WeatherParts,p)
	end

	WeatherConnection = RunService.RenderStepped:Connect(function(dt)
		local character = Player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")

		if not root then
			return
		end

		for _, p in ipairs(WeatherParts) do
			if p.Parent then
				if p.Position.Y < root.Position.Y - 5 then
					p.Position = root.Position + Vector3.new(
						math.random(-30,30),
						math.random(18,32),
						math.random(-30,30)
					)
				else
					p.CFrame = p.CFrame + Vector3.new(
						math.sin(os.clock() + p.Position.X) * dt,
						-7 * dt,
						math.cos(os.clock() + p.Position.Z) * dt
					)
				end
			end
		end
	end)
end

local function RestoreWet()
	for part,data in pairs(WetOriginal) do
		if part and part.Parent then
			part.Reflectance = data.Reflectance
		end
	end

	table.clear(WetOriginal)
end

local function StopWet()
	WetEnabled = false

	if WetConnection then
		WetConnection:Disconnect()
		WetConnection = nil
	end

	RestoreWet()
end

local function StartWet()
	StopWet()
	WetEnabled = true

	local timer = 0

	WetConnection = RunService.Heartbeat:Connect(function(dt)
		timer += dt

		if timer < 1.5 then
			return
		end

		timer = 0

		local character = Player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")

		if not root then
			return
		end

		local checked = 0

		for _, obj in ipairs(workspace:GetDescendants()) do
			if checked >= 250 then
				break
			end

			if obj:IsA("BasePart")
				and obj.Transparency < 0.95
				and not obj:IsDescendantOf(EffectFolder) then

				local distance = (obj.Position - root.Position).Magnitude

				if distance <= 50 then
					if not WetOriginal[obj] then
						WetOriginal[obj] = {
							Reflectance = obj.Reflectance
						}
					end

					obj.Reflectance = math.max(
						WetOriginal[obj].Reflectance,
						0.07
					)

					checked += 1
				end
			end
		end
	end)
end

local function RemoveSkies()
	for _, object in ipairs(Lighting:GetChildren()) do
		if object:IsA("Sky") then
			object:Destroy()
		end
	end
end

local function RestoreOriginalSky()
	RemoveSkies()

	for _, sky in ipairs(OriginalSkies) do
		sky:Clone().Parent = Lighting
	end
end

local function ApplyWarmSky()
	RemoveSkies()

	local sky = Instance.new("Sky")
	sky.Name = "ChrisShaderSky"

	sky.SkyboxBk = VerifiedWarmSky.Bk
	sky.SkyboxDn = VerifiedWarmSky.Dn
	sky.SkyboxFt = VerifiedWarmSky.Ft
	sky.SkyboxLf = VerifiedWarmSky.Lf
	sky.SkyboxRt = VerifiedWarmSky.Rt
	sky.SkyboxUp = VerifiedWarmSky.Up

	sky.Parent = Lighting
end

local function RestoreNormal()
	ClearWeather()
	StopWet()
	RestoreOriginalSky()

	Lighting.Brightness = Original.Brightness
	Lighting.ClockTime = Original.ClockTime
	Lighting.FogStart = Original.FogStart
	Lighting.FogEnd = Original.FogEnd
	Lighting.FogColor = Original.FogColor
	Lighting.Ambient = Original.Ambient
	Lighting.OutdoorAmbient = Original.OutdoorAmbient
	Lighting.ExposureCompensation = Original.ExposureCompensation
	Lighting.ColorShift_Top = Original.ColorShift_Top
	Lighting.ColorShift_Bottom = Original.ColorShift_Bottom
	Lighting.EnvironmentDiffuseScale = Original.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = Original.EnvironmentSpecularScale
	Lighting.GeographicLatitude = Original.GeographicLatitude

	CC.Enabled = false
	Bloom.Enabled = false
	SunRays.Enabled = false
	Atmosphere.Enabled = false
end

local function ApplyPreset(index)
	local preset = Presets[index]

	if not preset then
		return
	end

	ClearWeather()
	StopWet()

	Lighting.Brightness = preset.Brightness
	Lighting.ClockTime = preset.Clock
	Lighting.FogStart = preset.FogStart
	Lighting.FogEnd = preset.FogEnd
	Lighting.FogColor = preset.FogColor
	Lighting.Ambient = preset.Ambient
	Lighting.OutdoorAmbient = preset.Outdoor
	Lighting.ExposureCompensation = preset.Exposure

	CC.Enabled = true
	CC.Brightness = preset.CCBrightness
	CC.Contrast = preset.Contrast
	CC.Saturation = preset.Saturation
	CC.TintColor = preset.Tint

	Bloom.Enabled = true
	Bloom.Intensity = preset.Bloom
	Bloom.Size = 24
	Bloom.Threshold = 1.1

	SunRays.Enabled = true
	SunRays.Intensity = preset.Sun
	SunRays.Spread = 0.8

	Atmosphere.Enabled = true
	Atmosphere.Density = preset.Density
	Atmosphere.Haze = preset.Haze
	Atmosphere.Glare = 0.05
	Atmosphere.Offset = 0

	if preset.Sky then
		ApplyWarmSky()
	else
		RestoreOriginalSky()
	end

	if preset.Name == "Rainy" then
		CreateRain()
		StartWet()
	elseif preset.Name == "Winter" then
		CreateSnow()
	end

	selectedIndex = index
end

local function Create(class,parent,properties)
	local obj = Instance.new(class)

	for property,value in pairs(properties) do
		obj[property] = value
	end

	obj.Parent = parent
	return obj
end

