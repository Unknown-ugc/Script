--------------------------------------------------
-- UPDATE LOOP
--------------------------------------------------

local timer = 0

RunService.RenderStepped:Connect(function(dt)

	if not CONFIG.Enabled then
		return
	end

	if CONFIG.Rain then

		for _,drop in ipairs(rainDrops) do

			if drop.Transparency < 1 then

				drop.Position -= Vector3.new(
					0,
					CONFIG.RainSpeed * dt,
					0
				)

				if drop.Position.Y <
					camera.CFrame.Position.Y - 10 then

					drop.Position =
						randomRainPosition()
				end
			end
		end
	end

	timer += dt

	if timer >= CONFIG.ScanRate then

		timer = 0

		if CONFIG.Rain then
			scanGround()
		end

		updateLighting()
	end
end)

